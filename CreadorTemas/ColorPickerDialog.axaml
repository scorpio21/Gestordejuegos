<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CreadorTemas.ColorPickerDialog"
        Title="Seleccionar Color"
        Width="420"
        Height="460"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#1c1d22"
        RequestedThemeVariant="Dark"
        Icon="/img/iconoventana.png">

    <Window.Styles>
        <Style Selector="Slider">
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style Selector="Button.PresetBtn">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="BorderBrush" Value="#3f424a"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.PresetBtn:pointerover">
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*, 60" Margin="20">
        <!-- Contenido -->
        <StackPanel Grid.Row="0" Spacing="15">
            <TextBlock Text="Seleccionar Color" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>

            <!-- Vista Previa del Color Actual y Nuevo -->
            <Grid ColumnDefinitions="*, *" Height="60">
                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                    <TextBlock Text="Color Actual" Foreground="#9ba1af" FontSize="10" HorizontalAlignment="Center"/>
                    <Border Name="BrdCurrentColor" CornerRadius="3" Height="36" BorderBrush="#3f424a" BorderThickness="1"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4" Margin="10,0,0,0">
                    <TextBlock Text="Color Nuevo" Foreground="#9ba1af" FontSize="10" HorizontalAlignment="Center"/>
                    <Border Name="BrdNewColor" CornerRadius="3" Height="36" BorderBrush="#3f424a" BorderThickness="1"/>
                </StackPanel>
            </Grid>

            <!-- Paleta de Colores Predefinidos -->
            <TextBlock Text="Colores Predefinidos" Foreground="#9ba1af" FontSize="11" FontWeight="SemiBold"/>
            <UniformGrid Name="GridPresets" Columns="8" Rows="3" HorizontalAlignment="Center">
                <!-- Se poblará desde el code-behind con botones de color -->
            </UniformGrid>

            <Border Height="1" Background="#3f424a" Margin="0,5"/>

            <!-- Ajuste R, G, B -->
            <TextBlock Text="Personalizar Color (Rojo, Verde, Azul)" Foreground="#9ba1af" FontSize="11" FontWeight="SemiBold"/>
            <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="45, *, 35">
                <!-- Rojo -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Rojo" Foreground="#ef4444" FontSize="11" VerticalAlignment="Center"/>
                <Slider Name="SldRed" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" Value="128" ValueChanged="Slider_ValueChanged"/>
                <TextBlock Name="TxtRed" Grid.Row="0" Grid.Column="2" Text="128" Foreground="White" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <!-- Verde -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Verde" Foreground="#10b981" FontSize="11" VerticalAlignment="Center"/>
                <Slider Name="SldGreen" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="128" ValueChanged="Slider_ValueChanged"/>
                <TextBlock Name="TxtGreen" Grid.Row="1" Grid.Column="2" Text="128" Foreground="White" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>

                <!-- Azul -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Azul" Foreground="#3b82f6" FontSize="11" VerticalAlignment="Center"/>
                <Slider Name="SldBlue" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="128" ValueChanged="Slider_ValueChanged"/>
                <TextBlock Name="TxtBlue" Grid.Row="2" Grid.Column="2" Text="128" Foreground="White" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>

            <!-- Código Hexadecimal -->
            <Grid ColumnDefinitions="Auto, *" Margin="0,5,0,0">
                <TextBlock Text="Código Hex:" Foreground="#9ba1af" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Name="TxtHexCode" FontSize="11" Padding="6,4" TextChanged="TxtHexCode_TextChanged"/>
            </Grid>
        </StackPanel>

        <!-- Botones inferiores -->
        <Border Grid.Row="1" BorderBrush="#3f424a" BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Name="BtnAccept" Content="Aceptar" Click="BtnAccept_Click" Width="90" Height="28" Background="#2e3138" BorderBrush="#007acc" BorderThickness="1" Foreground="White" FontSize="11" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button Name="BtnCancel" Content="Cancelar" Click="BtnCancel_Click" Width="90" Height="28" Background="#2e3138" BorderBrush="#4f525a" BorderThickness="1" Foreground="White" FontSize="11" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
