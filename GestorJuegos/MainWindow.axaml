<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:GestorJuegos.Models"
        xmlns:services="clr-namespace:GestorJuegos.Services"
        xmlns:utils="clr-namespace:GestorJuegos.Utils"
        xmlns:controls="clr-namespace:GestorJuegos.Controls"
        xmlns:local="clr-namespace:GestorJuegos"
        xmlns:panels="clr-namespace:GestorJuegos.Views.Panels"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="GestorJuegos.MainWindow"
        Title="Gestor de Juegos"
        Background="{DynamicResource DeepDarkBrush}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="/img/iconoventana.png">


    <Grid>
        <!-- FONDO DINÁMICO (Inmersivo) -->
        <Panel Name="PnlBackground" IsHitTestVisible="False" Grid.RowSpan="5" Grid.ColumnSpan="5">
            <!-- 1. Fondo del Tema (Estatico del tema) -->
            <Image Name="ImgThemeBackground" Stretch="UniformToFill" Opacity="0.5" IsVisible="False">
                <Image.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.8" Easing="CubicEaseInOut"/>
                    </Transitions>
                </Image.Transitions>
            </Image>
            
            <!-- 2. Overlay del Tema (Vignette/Textura) -->
            <Image Name="ImgThemeOverlay" Stretch="UniformToFill" Opacity="0.7" IsVisible="False">
                <Image.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.8" Easing="CubicEaseInOut"/>
                    </Transitions>
                </Image.Transitions>
            </Image>
            
            <!-- 3. Fondo del Juego (Cambia al seleccionar juego) -->
            <Image Name="ImgBackground" Stretch="UniformToFill" Opacity="0.3">
                <Image.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.5"/>
                    </Transitions>
                </Image.Transitions>
            </Image>
            
            <!-- 4. Tinte de legibilidad -->
            <Border Background="{DynamicResource DeepDarkBrush}" Opacity="0.4"/>
        </Panel>
        
        <DockPanel>
            <!-- BARRA SUPERIOR MODULARIZADA -->
            <panels:TopBarView Name="TopBar" DockPanel.Dock="Top"/>

            <!-- CONTENIDO PRINCIPAL (3 PANELES) -->
            <Grid ColumnDefinitions="280, *, 350">
                <!-- IZQUIERDA: Sidebar de Filtros Inteligente -->
                <Border Grid.Column="0" Background="{DynamicResource DeepDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="5">
                    <DockPanel>
                        <!-- Logotipo del Tema / Aplicación -->
                        <Image Name="ImgAppLogo" Source="/img/icono.png" Width="120" Height="60" Margin="0,15,0,10" VerticalAlignment="Center" DockPanel.Dock="Top">
                            <Image.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.8" Easing="CubicEaseInOut"/>
                                </Transitions>
                            </Image.Transitions>
                        </Image>
                        
                        <!-- Selector de Vista estilo Biblioteca Externa -->
                        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" CornerRadius="8" Margin="5,5,5,10" Padding="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <ComboBox Name="CmbSidebarView" SelectedIndex="0" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="6">
                                <ComboBoxItem Content="Categoría de Plataforma"/>
                                <ComboBoxItem Content="Plataformas"/>
                                <ComboBoxItem Content="Géneros"/>
                                <ComboBoxItem Content="Regiones"/>
                                <ComboBoxItem Content="Biblioteca"/>
                            </ComboBox>
                        </Border>

                        <Button DockPanel.Dock="Bottom" Name="BtnAddPlatform" Content="+ Nueva Plataforma" Background="Transparent" Foreground="#64748b" HorizontalAlignment="Stretch" Margin="5" Padding="10"/>
                        
                        <ScrollViewer>
                            <TreeView Name="TvSidebar" x:CompileBindings="False" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource SidebarNodeTemplate}">
                                <TreeView.Styles>
                                    <Style Selector="TreeViewItem">
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu>
                                                    <MenuItem Header="Editar Plataforma" Click="MenuEditPlatformSidebar_Click">
                                                        <MenuItem.Icon>
                                                             <TextBlock Text="✏️"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Eliminar Plataforma" Click="MenuDeletePlatformSidebar_Click">
                                                        <MenuItem.Icon>
                                                             <TextBlock Text="🗑️" Foreground="#ef4444"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="CornerRadius" Value="8"/>
                                        <Setter Property="Margin" Value="5,1"/>
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    </Style>
                                </TreeView.Styles>
                            </TreeView>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- CENTRO: Juegos -->
                <Border Grid.Column="1" Padding="15">
                    <DockPanel>
                        <Panel DockPanel.Dock="Top">
                            <TextBlock Name="TxtSelectedPlatform" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                            
                            <!-- Filtros Avanzados (Opcional, ahora desplegable si se desea) -->
                            <Button Name="BtnToggleFilters" Content="▼ Filtros" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"/>
                        </Panel>

                        <Border Name="PnlFilters" DockPanel.Dock="Top" IsVisible="False" Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Región:" Margin="0,0,10,0" VerticalAlignment="Center"/><ComboBox Name="CmbFilterRegion" SelectedIndex="0" Margin="0,0,20,0"><ComboBoxItem Content="Todas"/><ComboBoxItem Content="🇺🇸 US"/><ComboBoxItem Content="🇪🇺 EU"/><ComboBoxItem Content="🇪🇸 ES"/><ComboBoxItem Content="🇯🇵 JP"/></ComboBox>
                                <TextBlock Text="Año:" Margin="0,0,10,0" VerticalAlignment="Center"/><NumericUpDown Name="NumFilterYear" Minimum="0" Maximum="2100" Width="100" Margin="0,0,20,0"/>
                                <TextBlock Text="Orden:" Margin="0,0,10,0" VerticalAlignment="Center"/><ComboBox Name="CmbSortOrder" SelectedIndex="0"><ComboBoxItem Content="Nombre (A-Z)"/><ComboBoxItem Content="Año (Asc)"/><ComboBoxItem Content="Recién añadidos"/></ComboBox>
                                <Button Name="BtnApplyFilters" Content="Aplicar" Margin="20,0,5,0" Background="{DynamicResource AccentBrush}" Foreground="White"/>
                                <Button Name="BtnClearFilters" Content="Limpiar" Background="{DynamicResource BorderBrush}" Foreground="White"/>
                            </WrapPanel>
                        </Border>

                        <StackPanel Name="PnlPagination" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,15,0,0" IsVisible="False">
                            <Button Name="BtnPrevPage" Content="⬅ Anterior"/><TextBlock Name="TxtPageInfo" Text="Página 1" VerticalAlignment="Center"/><Button Name="BtnNextPage" Content="Siguiente ➡"/>
                        </StackPanel>

                        <Panel>
                            <!-- Dashboard (Clean) -->
                            <ScrollViewer Name="PnlDashboard" IsVisible="True">
                                <StackPanel Spacing="30" VerticalAlignment="Center" Margin="0,100,0,0">
                                    <TextBlock Text="🎮" FontSize="80" HorizontalAlignment="Center" Opacity="0.2"/>
                                    <TextBlock Text="¡BIENVENIDO!" FontSize="36" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" Opacity="0.7"/>
                                    <TextBlock Text="Tu colección de juegos está lista. Selecciona un sistema en el panel izquierdo para empezar a jugar o utiliza los botones superiores para gestionar tu biblioteca." 
                                               FontSize="18" Foreground="#94a3b8" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="600"/>
                                    
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
                                        <Button Name="BtnShowPlatformsWall" Content="VER MURO DE PLATAFORMAS" Background="{DynamicResource BorderBrush}" Foreground="White" Padding="25,12" CornerRadius="8"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Listas -->
                            <ListBox Name="LstGames" IsVisible="False" Background="Transparent" BorderThickness="0">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu>
                                                    <MenuItem Header="Jugar" Click="BtnLaunchGame_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="▶" Foreground="#10b981"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator/>
                                                    <MenuItem Header="Editar" Click="BtnEditGame_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="✏️"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Abrir Carpeta" Click="BtnOpenFolder_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="📁"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Añadir de Favoritos" Click="BtnToggleFavorite_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="⭐" Foreground="#f59e0b"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator/>
                                                    <MenuItem Header="Eliminar" Click="BtnDelete_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="🗑️" Foreground="#ef4444"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <!-- Cambia sutilmente el borde del contenedor al color del hover del tema -->
                                    <Style Selector="ListBoxItem:pointerover Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Game">
                                        <Border Background="{DynamicResource PanelBrush}" Margin="0,0,0,5" Padding="10" CornerRadius="8" PointerEntered="GameItem_PointerEntered">
                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                <Image Grid.Column="0" Source="{Binding Cover, Converter={StaticResource ByteToBitmap}}" Width="40" Height="60" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" VerticalAlignment="Center" FontWeight="Bold"/>
                                                <Image Grid.Column="2" Source="{Binding Region, Converter={StaticResource RegionToFlag}}" Width="24" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <ListBox Name="LstGamesGrid" IsVisible="False" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource GameGridTemplate}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemWidth="180"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="ContextMenu">
                                            <Setter.Value>
                                                <ContextMenu>
                                                    <MenuItem Header="Jugar" Click="BtnLaunchGame_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="▶" Foreground="#10b981"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator/>
                                                    <MenuItem Header="Editar" Click="BtnEditGame_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="✏️"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Abrir Carpeta" Click="BtnOpenFolder_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="📁"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Header="Añadir de Favoritos" Click="BtnToggleFavorite_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="⭐" Foreground="#f59e0b"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <Separator/>
                                                    <MenuItem Header="Eliminar" Click="BtnDelete_Click">
                                                        <MenuItem.Icon>
                                                            <TextBlock Text="🗑️" Foreground="#ef4444"/>
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Transitions">
                                            <Transitions>
                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                                            </Transitions>
                                        </Setter>
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover">
                                        <Setter Property="RenderTransform" Value="scale(1.05)"/>
                                        <Setter Property="ZIndex" Value="1"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected Border#CoverBorder">
                                        <!-- El borde ahora se ilumina dinámicamente con el color de acento del tema -->
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected Border#PlaceholderBorder">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Style>
                                    <!-- Efecto de Hover para carátulas reales -->
                                    <Style Selector="ListBoxItem:pointerover Border#CoverBorder">
                                        <Setter Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                        <Setter Property="BoxShadow" Value="{DynamicResource HoverBoxShadow}"/>
                                    </Style>
                                    <!-- Efecto de Hover para placeholders de juegos sin carátula -->
                                    <Style Selector="ListBoxItem:pointerover Border#PlaceholderBorder">
                                        <Setter Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                        <Setter Property="BoxShadow" Value="{DynamicResource HoverBoxShadow}"/>
                                    </Style>
                                </ListBox.Styles>
                            </ListBox>

                            <!-- NUEVA VISTA: WHEEL VERTICAL (Estilo Biblioteca Externa) -->
                            <ListBox Name="LstGamesWheelVertical" IsVisible="False" Background="Transparent" BorderThickness="0" Padding="0,200">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Game">
                                        <Panel Height="100" Margin="0,5">
                                            <Image Source="{Binding Cover, Converter={StaticResource ByteToBitmap}}" Stretch="Uniform" HorizontalAlignment="Right" Margin="0,0,40,0"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,160,0" FontSize="18" FontWeight="Bold" Foreground="White" Opacity="0.5"/>
                                        </Panel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Opacity" Value="0.6"/>
                                        <Setter Property="RenderTransform">
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
                                                <TranslateTransform X="-50"/>
                                            </TransformGroup>
                                        </Setter>
                                        <Setter Property="Transitions">
                                            <Transitions>
                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut"/>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                                            </Transitions>
                                        </Setter>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="ZIndex" Value="10"/>
                                        <Setter Property="RenderTransform">
                                            <TransformGroup>
                                                <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                                <TranslateTransform X="0"/>
                                            </TransformGroup>
                                        </Setter>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                    <!-- Efecto Hover -->
                                    <Style Selector="ListBoxItem:pointerover">
                                        <Setter Property="Opacity" Value="0.9"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource HoverBorderBrush}"/>
                                    </Style>
                                </ListBox.Styles>
                            </ListBox>

                            <!-- NUEVA VISTA: WHEEL HORIZONTAL (Estilo CoverFlow) -->
                            <ListBox Name="LstGamesWheelHorizontal" IsVisible="False" Background="Transparent" BorderThickness="0" Padding="200,0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Game">
                                        <Panel Width="200" Height="300" Margin="10,0">
                                            <Border CornerRadius="10" ClipToBounds="True" BoxShadow="0 10 20 0 #80000000">
                                                <Image Source="{Binding Cover, Converter={StaticResource ByteToBitmap}}" Stretch="UniformToFill"/>
                                            </Border>
                                        </Panel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Opacity" Value="0.5"/>
                                        <Setter Property="RenderTransform">
                                            <ScaleTransform ScaleX="0.7" ScaleY="0.7"/>
                                        </Setter>
                                        <Setter Property="Transitions">
                                            <Transitions>
                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4" Easing="CubicEaseOut"/>
                                                <DoubleTransition Property="Opacity" Duration="0:0:0.4"/>
                                            </Transitions>
                                        </Setter>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="ZIndex" Value="10"/>
                                        <Setter Property="RenderTransform">
                                            <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                        </Setter>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                    <!-- Efecto Hover -->
                                    <Style Selector="ListBoxItem:pointerover">
                                        <Setter Property="Opacity" Value="0.9"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource HoverBorderBrush}"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                    </Style>
                                </ListBox.Styles>
                            </ListBox>
                            
                            <DockPanel Name="PnlGlobalSearch" IsVisible="False">
                                <Button Name="BtnBackFromSearch" DockPanel.Dock="Top" Content="⬅ Volver" Margin="0,0,0,10"/>
                                <TextBlock Name="TxtSearchStatus" DockPanel.Dock="Top" Foreground="#94a3b8" Margin="0,0,0,10"/>
                                <ListBox Name="LstGlobalSearchResults" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:Game">
                                            <Border Background="{DynamicResource PanelBrush}" Margin="0,0,0,5" Padding="10" CornerRadius="8">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <Image Grid.Column="0" Source="{Binding Cover, Converter={StaticResource ByteToBitmap}}" Width="40" Height="60" Margin="0,0,10,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding Platform.Name}" Foreground="#64748b" FontSize="12"/>
                                                    </StackPanel>
                                                    <Image Grid.Column="2" Source="{Binding Region, Converter={StaticResource RegionToFlag}}" Width="24" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Panel>
                    </DockPanel>
                </Border>

                <!-- DERECHA: Info (Premium Biblioteca Externa Style) -->
                <Border Grid.Column="2" Background="{DynamicResource DeepDarkBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
                    <ScrollViewer>
                        <Panel>
                            <!-- COMPONENTE MODULAR DE DETALLES DEL JUEGO -->
                            <panels:GameDetailsView Name="GameDetails" IsVisible="False"/>

                            <!-- DERECHA: Info de Plataforma o Categoría (Biblioteca Externa Style) -->
                            <StackPanel Name="PnlPlatformDetails" IsVisible="False" Spacing="0">
                                <!-- Banner Superior de Plataforma/Categoría -->
                                <Panel Height="200">
                                    <Border Background="{DynamicResource PanelBrush}" ClipToBounds="True">
                                        <!-- Imagen de fondo difuminada para estética premium -->
                                        <Image Name="ImgPlatformBackground" Stretch="UniformToFill" Opacity="0.15"/>
                                    </Border>
                                    
                                    <!-- Gradiente para desvanecer con el fondo azul oscuro de la app -->
                                    <Border>
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                <GradientStop Offset="0" Color="Transparent"/>
                                                <GradientStop Offset="0.8" Color="#150f172a"/>
                                                <GradientStop Offset="1" Color="{DynamicResource DeepDarkColor}"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- Acciones Rápidas (Esquina superior derecha) -->
                                    <Border Background="#600f172a" CornerRadius="18" Padding="3" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="15" BorderBrush="#20ffffff" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button Name="BtnEditPlatformQuick" Background="Transparent" Foreground="White" Width="32" Height="32" CornerRadius="16" Padding="0" ToolTip.Tip="Editar Plataforma">
                                                <TextBlock Text="✏️" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                            </Button>
                                            <Button Name="BtnClosePlatformDetails" Background="Transparent" Foreground="White" Width="32" Height="32" CornerRadius="16" Padding="0" ToolTip.Tip="Cerrar Detalles">
                                                <TextBlock Text="✕" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- Clear Logo de la plataforma/categoría -->
                                    <Border Name="BrdPlatformLogo" 
                                            Background="Transparent" 
                                            VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Height="100" Width="260"
                                            Margin="0,20,0,0">
                                        <Image Name="ImgPlatformLogo" Stretch="Uniform"/>
                                    </Border>

                                    <!-- Fecha de estreno (Abajo del logotipo / centrado) -->
                                    <TextBlock Name="TxtPlatformReleaseDate" 
                                               Text="Estrenado en 01/01/1984" 
                                               Foreground="#94a3b8" 
                                               FontSize="11" 
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Bottom" 
                                               Margin="0,0,0,10"/>
                                </Panel>

                                <!-- Imagen central de hardware (Foto física de la consola) -->
                                <Border Name="BrdPlatformHardware" Background="#101e293b" CornerRadius="10" ClipToBounds="True" Height="220" BoxShadow="0 4 12 0 #50000000" Margin="15,10">
                                    <Panel>
                                        <Image Name="ImgPlatformHardware" Stretch="Uniform" Margin="15"/>
                                        <TextBlock Name="TxtPlatformHardwarePlaceholder" Text="Sin foto del sistema" Foreground="#64748b" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False"/>
                                    </Panel>
                                </Border>

                                <!-- Tabla de Datos Técnicos y Estadísticas -->
                                <Border Background="#101e293b" BorderBrush="#20334155" BorderThickness="0,1" Padding="15,15" Margin="15,5">
                                    <StackPanel Name="PnlPlatformStatsTable" Spacing="8">
                                        <!-- Filas Técnicas de Plataforma (se ocultan si es Categoría) -->
                                        <Grid Name="RowPlatDeveloper" ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                            <TextBlock Text="Desarrollador:" Foreground="#64748b" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Name="TxtPlatDeveloper" Text="--" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                        </Grid>
                                        <Grid Name="RowPlatManufacturer" ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                            <TextBlock Text="Fabricante:" Foreground="#64748b" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Name="TxtPlatManufacturer" Text="--" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                        </Grid>
                                        <Grid Name="RowPlatCpu" ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                            <TextBlock Text="CPU:" Foreground="#64748b" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Name="TxtPlatCpu" Text="--" Foreground="White" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="180" HorizontalAlignment="Right" TextAlignment="Right"/>
                                        </Grid>
                                        <Grid Name="RowPlatMemory" ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                            <TextBlock Text="Memoria:" Foreground="#64748b" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Name="TxtPlatMemory" Text="--" Foreground="White" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="180" HorizontalAlignment="Right" TextAlignment="Right"/>
                                        </Grid>
                                        <Grid Name="RowPlatGraphics" ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                            <TextBlock Text="Gráficos:" Foreground="#64748b" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Name="TxtPlatGraphics" Text="--" Foreground="White" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="180" HorizontalAlignment="Right" TextAlignment="Right"/>
                                        </Grid>
                                        <Grid Name="RowPlatSound" ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                            <TextBlock Text="Sonido:" Foreground="#64748b" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Name="TxtPlatSound" Text="--" Foreground="White" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="180" HorizontalAlignment="Right" TextAlignment="Right"/>
                                        </Grid>
                                        <Grid Name="RowPlatDisplay" ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                            <TextBlock Text="Mostrar:" Foreground="#64748b" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Name="TxtPlatDisplay" Text="--" Foreground="White" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="180" HorizontalAlignment="Right" TextAlignment="Right"/>
                                        </Grid>
                                        <Grid Name="RowPlatMedia" ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                            <TextBlock Text="Multimedia:" Foreground="#64748b" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Name="TxtPlatMedia" Text="--" Foreground="White" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="180" HorizontalAlignment="Right" TextAlignment="Right"/>
                                        </Grid>
                                        
                                        <!-- Separador sutil -->
                                        <Border Height="1" Background="#15334155" Margin="0,5"/>
 
                                        <!-- Filas de Estadísticas Locales -->
                                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                            <TextBlock Text="Juegos en Total:" Foreground="#64748b" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Name="TxtPlatTotalGames" Text="0" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                            <TextBlock Text="Juegos Completados:" Foreground="#64748b" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Name="TxtPlatCompletedGames" Text="0" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                            <TextBlock Text="Última vez jugado:" Foreground="#64748b" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Name="TxtPlatLastPlayed" Text="Nunca" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                        </Grid>
                                        <Grid Name="RowPlatLastPlayedGame" ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                            <TextBlock Text="Último Juego Jugado:" Foreground="#64748b" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Name="TxtPlatLastPlayedGame" Text="--" Foreground="White" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="180" HorizontalAlignment="Right" TextAlignment="Right"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                            <TextBlock Text="Veces Jugado:" Foreground="#64748b" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Name="TxtPlatPlayCount" Text="0" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                            <TextBlock Text="Tiempo Jugado:" Foreground="#64748b" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Name="TxtPlatPlayTime" Text="0h 00m 00s" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                        </Grid>
                                        <Grid Name="RowPlatMostPlayedGame" ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                            <TextBlock Text="Juego Más Jugado:" Foreground="#64748b" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Name="TxtPlatMostPlayedGame" Text="--" Foreground="White" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="180" HorizontalAlignment="Right" TextAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Descripción histórica con scroll -->
                                <StackPanel Spacing="5" Margin="15,10,15,20">
                                    <TextBlock Text="DESCRIPCIÓN HISTÓRICA" Classes="Header" Foreground="#64748b" FontSize="11" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <Border Background="{DynamicResource PanelBrush}" Padding="15" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" MinHeight="100" MaxHeight="250">
                                        <ScrollViewer>
                                            <TextBlock Name="TxtPlatDescription" Foreground="#cbd5e1" FontSize="13" TextWrapping="Wrap" Opacity="0.95" LineHeight="20"/>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Estado Vacío cuando no hay juego seleccionado -->
                            <StackPanel Name="PnlNoGameSelected" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.2">
                                <TextBlock Text="🎮" FontSize="60" HorizontalAlignment="Center"/>
                                <TextBlock Text="Selecciona un juego" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Panel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>

        <!-- OVERLAYS (Necesarios para el .cs) -->
        <local:EditGameView Name="OverlayEditGame" IsVisible="False" ZIndex="150" />

        <local:FullStatsView Name="OverlayFullStats" IsVisible="False" ZIndex="160" />

        <Border Name="OverlayProgress" Background="#AA000000" IsVisible="False" ZIndex="200">
            <Border Background="{DynamicResource PanelBrush}" Width="400" Padding="30" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Spacing="15"><TextBlock Name="TxtProgressTitle" FontWeight="Bold"/><ProgressBar Name="ProgBarImport" Height="15"/><TextBlock Name="TxtProgressDetail"/><Button Name="BtnCancelProgress" Content="CANCELAR" Background="#ef4444" HorizontalAlignment="Center"/></StackPanel></Border>
        </Border>

        <Border Name="OverlayMessage" Background="#AA000000" IsVisible="False" ZIndex="300">
            <Border Background="{DynamicResource PanelBrush}" Width="400" Padding="30" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="20">
                    <TextBlock Name="TxtMessageContent" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <Button Name="BtnCloseMessage" Content="ACEPTAR" Background="#10b981" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Padding="30,10" Click="BtnCloseMessage_Click"/>
                </StackPanel>
            </Border>
        </Border>

        <Border Name="OverlayConfirm" Background="#AA000000" IsVisible="False" ZIndex="350">
            <Border Background="{DynamicResource PanelBrush}" Width="400" Padding="30" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="20">
                    <TextBlock Name="TxtConfirmTitle" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock Name="TxtConfirmContent" TextWrapping="Wrap" TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15">
                        <Button Name="BtnCancelConfirm" Content="CANCELAR" Click="BtnCancelConfirm_Click"/>
                        <Button Name="BtnAcceptConfirm" Content="ACEPTAR" Background="#ef4444" Foreground="White" Click="BtnAcceptConfirm_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Diálogo de Confirmación de Borrado estilo Biblioteca Externa -->
        <Border Name="OverlayDeleteConfirm" Background="#AA000000" IsVisible="False" ZIndex="400">
            <Border Background="#252830" BorderBrush="#3f424a" BorderThickness="1" Width="480" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <!-- Barra de Título del Diálogo -->
                    <Border Background="#1f2128" Height="30" Padding="10,0" DockPanel.Dock="Top">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="Gestor de Juegos" Foreground="#9ba1af" FontSize="11" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <Button Grid.Column="1" Name="BtnCloseDeleteConfirm" Background="Transparent" BorderThickness="0" Padding="5,0" Click="BtnCloseDeleteConfirm_Click">
                                <TextBlock Text="✕" Foreground="#9ba1af" FontSize="10"/>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <!-- Botones de Acción Abajo (Barra de Botones) -->
                    <Border Background="#1f2128" Height="50" Padding="15,0" BorderBrush="#3f424a" BorderThickness="0,1,0,0" DockPanel.Dock="Bottom">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" VerticalAlignment="Center">
                            <Button Name="BtnDeleteConfirmYes" Content="Yes" Width="75" Height="25" Background="#2e3138" BorderBrush="#4f525a" BorderThickness="1" Foreground="White" FontSize="11" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="BtnDeleteConfirmYes_Click"/>
                            <Button Name="BtnDeleteConfirmNo" Content="No" Width="75" Height="25" Background="#2e3138" BorderBrush="#007acc" BorderThickness="1.5" Foreground="White" FontSize="11" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="BtnDeleteConfirmNo_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Cuerpo del Diálogo -->
                    <Border Padding="25">
                        <Grid ColumnDefinitions="Auto, *">
                            <!-- Icono de Pregunta -->
                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#007acc" Margin="0,0,20,0" VerticalAlignment="Top">
                                <TextBlock Text="?" Foreground="White" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                            </Border>
                            
                            <!-- Contenido -->
                            <StackPanel Grid.Column="1" Spacing="15" VerticalAlignment="Center">
                                <TextBlock Name="TxtDeleteConfirmMessage" Text="¿Estás seguro que deseas borrar permanentemente Platform Game?" Foreground="White" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                                <CheckBox Name="ChkDeleteAssociatedMedia" Content="Delete associated media" Foreground="#9ba1af" FontSize="11" IsChecked="False"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
        </Border>

        <Border Name="OverlayExportOptions" Background="#AA000000" IsVisible="False" ZIndex="100">
            <Border Background="{DynamicResource PanelBrush}" Width="400" Padding="30" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="15">
                    <TextBlock Text="Opciones de Exportación" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                    <CheckBox Name="ChkExportGames" Content="Juegos (Base de Datos Principal)"/>
                    <CheckBox Name="ChkExportCovers" Content="Carátulas (Base de Datos Multimedia)"/>
                    <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
                        <Button Name="BtnCancelExport" Content="CANCELAR" Grid.Column="0" HorizontalAlignment="Stretch" Margin="0,0,5,0" Click="BtnCancelExport_Click"/>
                        <Button Name="BtnConfirmExport" Content="EXPORTAR" Grid.Column="1" HorizontalAlignment="Stretch" Margin="5,0,0,0" Background="#3b82f6" Foreground="White" Click="BtnConfirmExport_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Gestión de Plataformas -->
        <local:ManagePlatformsView Name="OverlayManagePlatforms" IsVisible="False" ZIndex="100"/>

        <Border Name="OverlayKeyboard" Background="#AA000000" IsVisible="False" ZIndex="500">
            <Border Background="{DynamicResource DeepDarkBrush}" Width="800" Padding="20" CornerRadius="15"><StackPanel Spacing="20"><TextBox Name="TxtKeyboardInput"/><Grid Name="GridKeyboard"/></StackPanel></Border>
        </Border>

        <Border Name="OverlayPlatformsWall" Background="#AA000000" IsVisible="False" ZIndex="100">
            <Border Background="{DynamicResource DeepDarkBrush}" Margin="50" CornerRadius="20" Padding="30">
                <DockPanel>
                    <Button Name="BtnClosePlatformsWall" DockPanel.Dock="Top" Content="✕" Background="Transparent" Foreground="#ef4444" FontSize="20" HorizontalAlignment="Right" Margin="0,0,0,20"/>
                    <ListBox Name="LstPlatformsWall" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Platform">
                                <Border Background="{DynamicResource PanelBrush}" Margin="10" Padding="20" CornerRadius="15" Width="220" Height="160">
                                    <StackPanel VerticalAlignment="Center">
                                        <Panel Height="80">
                                            <Image Source="{Binding Logo, Converter={StaticResource ByteToBitmap}}" Stretch="Uniform"/>
                                            <TextBlock Text="🎮" FontSize="50" HorizontalAlignment="Center" Opacity="0.1" VerticalAlignment="Center"/>
                                        </Panel>
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,15,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Border>
        
        <!-- OVERLAY PARA VISOR DE IMÁGENES -->
        <Border Name="OverlayImageViewer" Background="#EE000000" IsVisible="False" ZIndex="600" PointerPressed="OverlayImageViewer_PointerPressed">
            <Panel>
                <Image Name="ImgFullViewer" Stretch="Uniform" MaxWidth="1200" MaxHeight="900" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Name="BtnCloseImageViewer" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="25" Width="50" Height="50" Background="#33000000" Foreground="White" CornerRadius="25" Click="BtnCloseImageViewer_Click" FontSize="20"/>
            </Panel>
        </Border>

        <!-- Overlay de Logros Expandido -->
        <local:AchievementsView Name="OverlayAchievements" IsVisible="False" ZIndex="700"/>

    </Grid>
</Window>

