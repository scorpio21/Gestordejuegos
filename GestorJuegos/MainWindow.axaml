<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:GestorJuegos.Models"
        xmlns:services="clr-namespace:GestorJuegos.Services"
        xmlns:utils="clr-namespace:GestorJuegos.Utils"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="GestorJuegos.MainWindow"
        Title="Gestor de Juegos"
        Background="#0f172a"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="/img/iconoventana.png">

    <Window.Styles>
        <!-- Estilos para TabControl Moderno -->
        <Style Selector="TabControl.Modern">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TabControl.Modern TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
        </Style>
        <Style Selector="TabControl.Modern TabItem:selected">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#10b981"/>
        </Style>
        <Style Selector="TabControl.Modern TabItem:pointerover">
            <Setter Property="Foreground" Value="#cbd5e1"/>
        </Style>

        <!-- Estilos Globales para Inputs -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0f172a"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#10b981"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#0f172a"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style Selector="NumericUpDown">
            <Setter Property="Background" Value="#0f172a"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style Selector="Button.Secondary">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.Secondary:pointerover">
            <Setter Property="Background" Value="#475569"/>
        </Style>

        <Style Selector="TextBlock.Header">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#64748b"/>
        </Style>
    </Window.Styles>

    <Window.Resources>
        <utils:ByteArrayToBitmapConverter x:Key="ByteToBitmap"/>
        <utils:RegionToFlagConverter x:Key="RegionToFlag"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#10b981"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#1e293b"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#334155"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#64748b"/>
        <SolidColorBrush x:Key="DeepDarkBrush" Color="#0f172a"/>

        <!-- Plantilla para Items de Sidebar -->
        <DataTemplate x:Key="SidebarItemTemplate" x:DataType="models:SidebarItem">
            <Panel Margin="0,2">
                <TextBlock Text="{Binding Name}" 
                           IsVisible="{Binding IsHeader}" 
                           FontSize="11" FontWeight="Bold" Foreground="#64748b" Margin="5,15,0,5"/>
                
                <Grid ColumnDefinitions="Auto, *, Auto" IsVisible="{Binding !IsHeader}" Height="32" Background="Transparent" PointerEntered="SidebarItem_PointerEntered">
                    <TextBlock Grid.Column="0" Text="{Binding Icon}" Margin="5,0,10,0" VerticalAlignment="Center" FontSize="16"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Foreground="#cbd5e1" FontSize="13"/>
                    <Border Grid.Column="2" Background="#334155" CornerRadius="10" Padding="8,1" VerticalAlignment="Center" Margin="0,0,5,0">
                        <TextBlock Text="{Binding Count}" FontSize="10" Foreground="#94a3b8" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Panel>
        </DataTemplate>
        <!-- Plantilla para Rejilla de Juegos (Premium) -->
        <DataTemplate x:Key="GameGridTemplate" x:DataType="models:Game">
            <Border Name="RootBorder" Margin="8" CornerRadius="12" ClipToBounds="True" Background="#1e293b" BoxShadow="0 4 15 0 #AA000000" PointerEntered="GameItem_PointerEntered">
                <Panel>
                    <Image Source="{Binding Cover, Converter={StaticResource ByteToBitmap}}" Stretch="UniformToFill" Height="220" Width="160"/>
                    
                    <!-- Overlay de información (Sutil) -->
                    <Border VerticalAlignment="Bottom" Height="80">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Offset="0" Color="Transparent"/>
                                <GradientStop Offset="1" Color="#EE0f172a"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Margin="10,0,10,8" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="12" TextWrapping="Wrap" MaxLines="2"/>
                            <Grid ColumnDefinitions="*, Auto" Margin="0,2,0,0">
                                <TextBlock Grid.Column="0" Text="{Binding Year}" Foreground="#94a3b8" FontSize="10"/>
                                <Image Grid.Column="1" Source="{Binding Region, Converter={StaticResource RegionToFlag}}" Width="16"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Indicador de Favorito -->
                    <TextBlock Text="⭐" IsVisible="{Binding IsFavorite}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5" FontSize="14"/>
                </Panel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- FONDO DINÁMICO (Inmersivo) -->
        <Panel Name="PnlBackground" IsHitTestVisible="False">
            <Image Name="ImgBackground" Stretch="UniformToFill" Opacity="0.2">
                <Image.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.5"/>
                    </Transitions>
                </Image.Transitions>
            </Image>
            <Border Background="#0f172a" Opacity="0.6"/> <!-- Capa de tinte oscuro para legibilidad -->
        </Panel>
        
        <DockPanel>
            <!-- BARRA SUPERIOR (MODERNA) -->
            <Border DockPanel.Dock="Top" Background="#1e293b" BorderBrush="#334155" BorderThickness="0,0,0,1" Height="60">
                <Grid ColumnDefinitions="Auto, *, Auto" Margin="15,0">
                    <!-- Izquierda: Menu y Logo -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="15">
                        <Button Name="BtnAppMenu" Background="Transparent" Padding="10" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Image Source="/img/icono.png" Width="24" Height="24"/>
                                <TextBlock Text="☰" Foreground="White" VerticalAlignment="Center" FontSize="18"/>
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="ARCHIVO">
                                        <MenuItem Name="MenuExportDB" Header="Exportar Copia de Seguridad..." Click="MenuExportDB_Click"/>
                                        <MenuItem Name="MenuImportDB" Header="Importar Copia de Seguridad..." Click="MenuImportDB_Click"/>
                                        <Separator/>
                                        <MenuItem Name="MenuSettings" Header="Configuración" Click="MenuSettings_Click"/>
                                    </MenuItem>
                                    <MenuItem Header="BIBLIOTECA">
                                        <MenuItem Name="MenuImportFolders" Header="Importar Colección desde Carpeta..." Click="MenuImportFolders_Click"/>
                                        <MenuItem Name="MenuImportLaunchBox" Header="Importar desde LaunchBox..." Click="MenuImportLaunchBox_Click"/>
                                        <Separator/>
                                        <MenuItem Name="MenuImportDat" Header="Importar lista desde DAT/XML..." Click="MenuImportDat_Click"/>
                                        <MenuItem Name="MenuScanLocalCovers" Header="Escanear Carátulas Locales..." Click="MenuScanLocalCovers_Click"/>
                                        <Separator/>
                                        <MenuItem Name="MenuCleanupOrphans" Header="Limpiar Juegos Huérfanos" Click="MenuCleanupOrphans_Click"/>
                                        <MenuItem Name="MenuManageDross" Header="Gestionar Filtros de Importación" Click="MenuManageDross_Click"/>
                                        <MenuItem Name="MenuBatchScrapeVimm" Header="Descargar Carátulas (Vimm)..." Click="MenuBatchScrapeVimm_Click"/>
                                    </MenuItem>
                                    <MenuItem Header="AYUDA">
                                        <MenuItem Name="MenuHelpEmulator" Header="Emuladores" Click="MenuHelpEmulator_Click"/>
                                        <MenuItem Name="MenuHelpMultiDisk" Header="Multi-Disco" Click="MenuHelpMultiDisk_Click"/>
                                        <MenuItem Name="MenuHelpDatabase" Header="Base de Datos" Click="MenuHelpDatabase_Click"/>
                                        <Separator/>
                                        <MenuItem Name="MenuAbout" Header="Acerca de..."/>
                                    </MenuItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <!-- Centro: Búsqueda -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#0f172a" CornerRadius="8" BorderBrush="#334155" BorderThickness="1" Width="550">
                        <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                            <TextBlock Text="🔍" Margin="10,0" VerticalAlignment="Center" Opacity="0.5"/>
                            <TextBox Grid.Column="1" Name="TxtSearchGame" PlaceholderText="Buscar en tu biblioteca..." Background="Transparent" BorderThickness="0" Margin="0" VerticalAlignment="Center" TextChanged="TxtSearchGame_TextChanged"/>
                            <ToggleButton Grid.Column="2" Name="BtnQuickFavorite" Content="⭐" Background="Transparent" BorderThickness="0" ToolTip.Tip="Solo Favoritos" Click="BtnQuickFavorite_Click"/>
                            <ToggleButton Grid.Column="3" Name="BtnToggleGamepad" Content="🎮" Background="Transparent" BorderThickness="0" ToolTip.Tip="Modo Mando (ON/OFF)" IsChecked="True"/>
                        </Grid>
                    </Border>

                    <!-- Derecha: Acciones y Vistas -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                        <Border Background="#0f172a" CornerRadius="8" Padding="2" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton Name="BtnViewGrid" Content="▤" ToolTip.Tip="Vista Galería" Padding="12,6" Background="Transparent" BorderThickness="0" CornerRadius="6"/>
                                <ToggleButton Name="BtnViewList" Content="≡" ToolTip.Tip="Vista Lista" Padding="12,6" Background="Transparent" BorderThickness="0" CornerRadius="6"/>
                            </StackPanel>
                        </Border>
                        
                        <Button Name="BtnAddGame" Content="+ Añadir" Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="Bold" CornerRadius="8" Padding="15,8"/>
                        <Button Name="BtnShowStats" Content="📊" Background="#334155" Foreground="White" CornerRadius="8" Padding="12,8" ToolTip.Tip="Estadísticas"/>
                        <Button Name="BtnManagePlatforms" Content="⚙️" Background="#334155" Foreground="White" CornerRadius="8" Padding="12,8" ToolTip.Tip="Gestionar Plataformas"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENIDO PRINCIPAL (3 PANELES) -->
            <Grid ColumnDefinitions="280, *, 350">
                <!-- IZQUIERDA: Sidebar de Filtros Inteligente -->
                <Border Grid.Column="0" Background="#0f172a" BorderBrush="#334155" BorderThickness="0,0,1,0" Padding="5">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Name="BtnAddPlatform" Content="+ Nueva Plataforma" Background="Transparent" Foreground="#64748b" HorizontalAlignment="Stretch" Margin="5" Padding="10"/>
                        <ScrollViewer>
                            <ListBox Name="LstSidebar" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource SidebarItemTemplate}">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="10,2"/>
                                        <Setter Property="CornerRadius" Value="8"/>
                                        <Setter Property="Margin" Value="5,0"/>
                                    </Style>
                                </ListBox.Styles>
                            </ListBox>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- CENTRO: Juegos -->
                <Border Grid.Column="1" Padding="15">
                    <DockPanel>
                        <Panel DockPanel.Dock="Top">
                            <TextBlock Name="TxtSelectedPlatform" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                            
                            <!-- Filtros Avanzados (Opcional, ahora desplegable si se desea) -->
                            <Button Name="BtnToggleFilters" Content="▼ Filtros" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"/>
                        </Panel>

                        <Border Name="PnlFilters" DockPanel.Dock="Top" IsVisible="False" Background="#1e293b" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Región:" Margin="0,0,10,0" VerticalAlignment="Center"/><ComboBox Name="CmbFilterRegion" SelectedIndex="0" Margin="0,0,20,0"><ComboBoxItem Content="Todas"/><ComboBoxItem Content="🇺🇸 US"/><ComboBoxItem Content="🇪🇺 EU"/><ComboBoxItem Content="🇪🇸 ES"/><ComboBoxItem Content="🇯🇵 JP"/></ComboBox>
                                <TextBlock Text="Año:" Margin="0,0,10,0" VerticalAlignment="Center"/><NumericUpDown Name="NumFilterYear" Minimum="0" Maximum="2100" Width="100" Margin="0,0,20,0"/>
                                <TextBlock Text="Orden:" Margin="0,0,10,0" VerticalAlignment="Center"/><ComboBox Name="CmbSortOrder" SelectedIndex="0"><ComboBoxItem Content="Nombre (A-Z)"/><ComboBoxItem Content="Año (Asc)"/><ComboBoxItem Content="Recién añadidos"/></ComboBox>
                                <Button Name="BtnApplyFilters" Content="Aplicar" Margin="20,0,5,0" Background="{StaticResource AccentBrush}" Foreground="White"/>
                                <Button Name="BtnClearFilters" Content="Limpiar" Background="#334155" Foreground="White"/>
                            </WrapPanel>
                        </Border>

                        <StackPanel Name="PnlPagination" DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20" Margin="0,15,0,0" IsVisible="False">
                            <Button Name="BtnPrevPage" Content="⬅ Anterior"/><TextBlock Name="TxtPageInfo" Text="Página 1" VerticalAlignment="Center"/><Button Name="BtnNextPage" Content="Siguiente ➡"/>
                        </StackPanel>

                        <Panel>
                            <!-- Dashboard (Clean) -->
                            <ScrollViewer Name="PnlDashboard" IsVisible="True">
                                <StackPanel Spacing="30" VerticalAlignment="Center" Margin="0,100,0,0">
                                    <TextBlock Text="🎮" FontSize="80" HorizontalAlignment="Center" Opacity="0.2"/>
                                    <TextBlock Text="¡BIENVENIDO!" FontSize="36" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center" Opacity="0.7"/>
                                    <TextBlock Text="Tu colección de juegos está lista. Selecciona un sistema en el panel izquierdo para empezar a jugar o utiliza los botones superiores para gestionar tu biblioteca." 
                                               FontSize="18" Foreground="#94a3b8" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="600"/>
                                    
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
                                        <Button Name="BtnShowPlatformsWall" Content="VER MURO DE PLATAFORMAS" Background="#334155" Foreground="White" Padding="25,12" CornerRadius="8"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Listas -->
                            <ListBox Name="LstGames" IsVisible="False" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:Game">
                                        <Border Background="#1e293b" Margin="0,0,0,5" Padding="10" CornerRadius="8" PointerEntered="GameItem_PointerEntered">
                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                <Image Grid.Column="0" Source="{Binding Cover, Converter={StaticResource ByteToBitmap}}" Width="40" Height="60" Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="White" VerticalAlignment="Center" FontWeight="Bold"/>
                                                <Image Grid.Column="2" Source="{Binding Region, Converter={StaticResource RegionToFlag}}" Width="24" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <ListBox Name="LstGamesGrid" IsVisible="False" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource GameGridTemplate}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemWidth="180"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Transitions">
                                            <Transitions>
                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                                            </Transitions>
                                        </Setter>
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover">
                                        <Setter Property="RenderTransform" Value="scale(1.05)"/>
                                        <Setter Property="ZIndex" Value="1"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </ListBox.Styles>
                            </ListBox>
                            
                            <DockPanel Name="PnlGlobalSearch" IsVisible="False">
                                <Button Name="BtnBackFromSearch" DockPanel.Dock="Top" Content="⬅ Volver" Margin="0,0,0,10"/>
                                <TextBlock Name="TxtSearchStatus" DockPanel.Dock="Top" Foreground="#94a3b8" Margin="0,0,0,10"/>
                                <ListBox Name="LstGlobalSearchResults" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:Game">
                                            <Border Background="#1e293b" Margin="0,0,0,5" Padding="10" CornerRadius="8">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <Image Grid.Column="0" Source="{Binding Cover, Converter={StaticResource ByteToBitmap}}" Width="40" Height="60" Margin="0,0,10,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding Platform.Name}" Foreground="#64748b" FontSize="12"/>
                                                    </StackPanel>
                                                    <Image Grid.Column="2" Source="{Binding Region, Converter={StaticResource RegionToFlag}}" Width="24" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Panel>
                    </DockPanel>
                </Border>

                <!-- DERECHA: Info (Premium) -->
                <Border Grid.Column="2" Background="#0f172a" BorderBrush="#334155" BorderThickness="1,0,0,0">
                    <ScrollViewer>
                        <Panel>
                            <StackPanel Name="PnlGameDetails" IsVisible="False" Spacing="0">
                                <StackPanel.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                                    </Transitions>
                                </StackPanel.Transitions>
                                <!-- Banner Superior Mejorado -->
                                <Panel Height="220">
                                    <Border Background="#1e293b" ClipToBounds="True">
                                        <Image Name="ImgDetailBackground" Stretch="UniformToFill" Opacity="0.4">
                                            <Image.Transitions>
                                                <Transitions>
                                                    <DoubleTransition Property="Opacity" Duration="0:0:0.5"/>
                                                </Transitions>
                                            </Image.Transitions>
                                        </Image>
                                    </Border>
                                    <!-- Contenedor del Logo (Ahora dinámico) -->
                                    <Border Name="BrdDetailLogo" 
                                            Background="Transparent" 
                                            VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                            Margin="0,0,0,10" 
                                            Height="120" Width="300"
                                            ZIndex="10">
                                        <Image Name="ImgDetailLogo" Stretch="Uniform">
                                            <Image.Transitions>
                                                <Transitions>
                                                    <DoubleTransition Property="Opacity" Duration="0:0:0.4"/>
                                                </Transitions>
                                            </Image.Transitions>
                                        </Image>
                                    </Border>
                                </Panel>

                                <Border Padding="20" Margin="0,10,0,0">
                                    <StackPanel Spacing="25">
                                        <!-- Cabecera Informativa -->
                                        <StackPanel Spacing="5">
                                            <TextBlock Name="TxtInfoName" FontSize="26" FontWeight="Black" Foreground="White" TextWrapping="Wrap" TextAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" Spacing="10" Opacity="0.7" HorizontalAlignment="Center">
                                                <Image Name="ImgInfoRegion" Width="20"/>
                                                <TextBlock Name="TxtInfoYear" VerticalAlignment="Center"/>
                                                <TextBlock Text="•" VerticalAlignment="Center"/>
                                                <TextBlock Name="TxtInfoGenre" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Botón Principal -->
                                        <Button Name="BtnLaunchGame" Background="#10b981" Foreground="White" Height="60" CornerRadius="12" HorizontalAlignment="Stretch" Padding="0">
                                            <Grid ColumnDefinitions="Auto, *">
                                                <Border Grid.Column="0" Background="#20000000" Width="60" CornerRadius="12,0,0,12">
                                                    <TextBlock Text="▶" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="JUGAR" FontSize="20" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,60,0"/>
                                            </Grid>
                                        </Button>

                                        <!-- Acciones Rápidas -->
                                        <Grid ColumnDefinitions="*, *, *">
                                            <Button Name="BtnEditGame" Classes="Secondary" Grid.Column="0" ToolTip.Tip="Editar Juego" Margin="0,0,5,0" Height="45">
                                                <TextBlock Text="✏️" HorizontalAlignment="Center"/>
                                            </Button>
                                            <Button Name="BtnOpenFolder" Classes="Secondary" Grid.Column="1" ToolTip.Tip="Abrir Carpeta" Margin="5,0,5,0" Height="45">
                                                <TextBlock Text="📁" HorizontalAlignment="Center"/>
                                            </Button>
                                            <Button Name="BtnDelete" Classes="Secondary" Grid.Column="2" ToolTip.Tip="Eliminar Juego" Margin="5,0,0,0" Height="45">
                                                <TextBlock Text="🗑️" Foreground="#ef4444" HorizontalAlignment="Center"/>
                                            </Button>
                                        </Grid>

                                        <Separator Background="#334155"/>

                                        <!-- Sobre el Juego -->
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="SOBRE EL JUEGO" Classes="Header"/>
                                            <Border Background="#1e293b" Padding="15" CornerRadius="12">
                                                <StackPanel Spacing="12">
                                                    <DockPanel Name="PnlInfoDeveloper">
                                                        <TextBlock Text="Desarrollador" Foreground="#64748b" FontSize="12"/>
                                                        <TextBlock Name="TxtInfoDeveloper" Foreground="White" HorizontalAlignment="Right" FontSize="12"/>
                                                    </DockPanel>
                                                    <DockPanel Name="PnlInfoPublisher">
                                                        <TextBlock Text="Distribuidor" Foreground="#64748b" FontSize="12"/>
                                                        <TextBlock Name="TxtInfoPublisher" Foreground="White" HorizontalAlignment="Right" FontSize="12"/>
                                                    </DockPanel>
                                                    <TextBlock Name="TxtInfoDescription" Foreground="#cbd5e1" FontSize="13" TextWrapping="Wrap" Opacity="0.9" LineHeight="20" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <Separator Background="#334155"/>

                                        <!-- Multimedia / Galería -->
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="CARÁTULA / MULTIMEDIA" Classes="Header"/>
                                            <Border Background="#1e293b" CornerRadius="12" MinHeight="250" MaxHeight="450" ClipToBounds="True">
                                                <Image Name="ImgCover" Stretch="Uniform" Margin="10">
                                                    <Image.Transitions>
                                                        <Transitions>
                                                            <DoubleTransition Property="Opacity" Duration="0:0:0.4"/>
                                                        </Transitions>
                                                    </Image.Transitions>
                                                </Image>
                                            </Border>
                                            <ComboBox Name="CmbArtType" SelectedIndex="3" HorizontalAlignment="Stretch" Background="#0f172a" BorderBrush="#334155" SelectionChanged="CmbArtType_SelectionChanged">
                                                <ComboBoxItem Content="Advert"/>
                                                <ComboBoxItem Content="Artwork Preview"/>
                                                <ComboBoxItem Content="Background"/>
                                                <ComboBoxItem Content="Box"/>
                                                <ComboBoxItem Content="Box Full"/>
                                                <ComboBoxItem Content="Box 3D"/>                                                <ComboBoxItem Content="Cabinet"/>
                                                <ComboBoxItem Content="Logos"/>
                                                <ComboBoxItem Content="Marquee"/>
                                                <ComboBoxItem Content="Snap"/>
                                                <ComboBoxItem Content="System Logo"/>
                                                <ComboBoxItem Content="Title"/>
                                            </ComboBox>                                        </StackPanel>

                                        <!-- Datos Técnicos -->
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="DETALLES TÉCNICOS" Classes="Header"/>
                                            <Border Background="#1e293b" Padding="15" CornerRadius="12">
                                                <StackPanel Spacing="10">
                                                    <DockPanel>
                                                        <TextBlock Text="Idiomas" Foreground="#64748b" FontSize="12"/>
                                                        <TextBlock Name="TxtInfoLanguages" Foreground="White" HorizontalAlignment="Right" FontSize="12"/>
                                                    </DockPanel>
                                                    <StackPanel Spacing="5">
                                                        <TextBlock Text="Archivos / Discos" Foreground="#64748b" FontSize="12"/>
                                                        <ItemsControl Name="LstInfoRoms">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding}" Foreground="#cbd5e1" FontSize="11" TextWrapping="Wrap" Margin="0,2"/>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <StackPanel Name="PnlInfoEmulator" IsVisible="False" Spacing="2">
                                                        <TextBlock Text="Emulador Custom" Foreground="#64748b" FontSize="12"/>
                                                        <TextBlock Name="TxtInfoEmulator" Foreground="#10b981" FontSize="11" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Name="PnlNoGameSelected" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.2">
                                <TextBlock Text="🎮" FontSize="60" HorizontalAlignment="Center"/>
                                <TextBlock Text="Selecciona un juego"/>
                            </StackPanel>
                        </Panel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>

        <!-- OVERLAYS (Necesarios para el .cs) -->
        <Border Name="OverlayEditGame" Background="#AA000000" IsVisible="False" ZIndex="150">
            <Border Background="#1e293b" Width="750" Height="650" CornerRadius="12" Padding="25" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 10 30 0 #AA000000">
                <DockPanel>
                    <!-- Header del Overlay -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
                        <TextBlock Name="TxtEditGameTitle" Text="Editar Juego" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Name="BtnCancelEditGameTop" Grid.Column="1" Content="✕" Background="Transparent" Foreground="#ef4444" FontSize="18" Padding="5" Click="BtnCancelEditGame_Click"/>
                    </Grid>

                    <!-- Botones de Acción (Pie) -->
                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,*" Margin="0,20,0,0">
                        <Button Name="BtnCancelEditGame" Grid.Column="0" Content="CANCELAR" Margin="0,0,10,0" HorizontalAlignment="Stretch" Click="BtnCancelEditGame_Click"/>
                        <Button Name="BtnSave" Grid.Column="1" Content="GUARDAR CAMBIOS" Background="#10b981" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" Click="BtnSave_Click"/>
                    </Grid>

                    <!-- Contenido en Pestañas -->
                    <TabControl Classes="Modern" Margin="0,5">
                        <!-- PESTAÑA 1: DETALLES -->
                        <TabItem Header="Detalles">
                            <ScrollViewer>
                                <StackPanel Spacing="15" Margin="0,15,10,0">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Spacing="5" Margin="0,0,10,0">
                                            <TextBlock Text="Nombre del Juego" FontSize="11" Foreground="#64748b"/>
                                            <TextBox Name="TxtName" PlaceholderText="Ej: Super Mario World"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Grid.Column="1" Spacing="5" VerticalAlignment="Bottom">
                                            <Button Name="BtnSyncLaunchBox" Content="🔄 Sincronizar LaunchBox" Background="#3b82f6" Foreground="White" Click="BtnSyncLaunchBox_Click"/>
                                            <Button Name="BtnSearchIgdb" Content="🔍 Buscar Vimm" Click="BtnSearchIgdb_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*, *, *">
                                        <StackPanel Spacing="5" Margin="0,0,10,0">
                                            <TextBlock Text="Año" FontSize="11" Foreground="#64748b"/>
                                            <NumericUpDown Name="NumYear" Minimum="1900" Maximum="2100" FormatString="0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="5" Margin="5,0,5,0">
                                            <TextBlock Text="Región" FontSize="11" Foreground="#64748b"/>
                                            <ComboBox Name="CmbRegion" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="🇺🇸 US"/><ComboBoxItem Content="🇪🇺 EU"/><ComboBoxItem Content="🇪🇸 ES"/><ComboBoxItem Content="🇯🇵 JP"/><ComboBoxItem Content="🌎 World"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="5" Margin="10,0,0,0">
                                            <TextBlock Text="Versión" FontSize="11" Foreground="#64748b"/>
                                            <TextBox Name="TxtVersion" PlaceholderText="v1.0"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*, *">
                                        <StackPanel Spacing="5" Margin="0,0,10,0">
                                            <TextBlock Text="Género(s)" FontSize="11" Foreground="#64748b"/>
                                            <TextBox Name="TxtGenre" PlaceholderText="Ej: Platform, Adventure"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="5" Margin="10,0,0,0">
                                            <TextBlock Text="Idiomas" FontSize="11" Foreground="#64748b"/>
                                            <TextBox Name="TxtLanguages" PlaceholderText="Ej: English, Spanish"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*, *">
                                        <StackPanel Spacing="5" Margin="0,0,10,0">
                                            <TextBlock Text="Desarrollador" FontSize="11" Foreground="#64748b"/>
                                            <TextBox Name="TxtDeveloper" PlaceholderText="Ej: Nintendo EAD"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="5" Margin="10,0,0,0">
                                            <TextBlock Text="Distribuidor" FontSize="11" Foreground="#64748b"/>
                                            <TextBox Name="TxtPublisher" PlaceholderText="Ej: Nintendo"/>
                                        </StackPanel>
                                    </Grid>

                                    <CheckBox Name="ChkIsFavorite" Content="Marcar como Favorito (⭐)" FontSize="13" Margin="0,5,0,0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- PESTAÑA 2: ESTADO Y VALORACIÓN (NUEVA PARA TU INFO) -->
                        <TabItem Header="Estado">
                            <ScrollViewer>
                                <StackPanel Spacing="20" Margin="0,15,10,0">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Estado del Juego" Classes="Header"/>
                                        <ComboBox Name="CmbPlayStatus" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Pendiente"/>
                                            <ComboBoxItem Content="Jugando"/>
                                            <ComboBoxItem Content="Completado"/>
                                            <ComboBoxItem Content="Abandonado"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Spacing="10">
                                        <TextBlock Text="Valoración (0-100)" Classes="Header"/>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Slider Name="SldRating" Minimum="0" Maximum="100" Value="0" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                            <TextBlock Grid.Column="1" Text="{Binding #SldRating.Value, StringFormat='\{0:0\}'}" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="20" FontWeight="Bold" Foreground="#10b981"/>
                                        </Grid>
                                    </StackPanel>

                                    <Border Background="#0f172a" Padding="15" CornerRadius="8">
                                        <Grid ColumnDefinitions="*, *">
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="VECES JUGADO" FontSize="10" Foreground="#64748b"/>
                                                <TextBlock Name="TxtPlayCount" Text="0" FontSize="24" FontWeight="Bold"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="5" HorizontalAlignment="Right">
                                                <TextBlock Text="AÑADIDO EL" FontSize="10" Foreground="#64748b" HorizontalAlignment="Right"/>
                                                <TextBlock Name="TxtDateAdded" Text="--" FontSize="14" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- PESTAÑA 3: ARCHIVOS -->
                        <TabItem Header="Archivos">
                            <ScrollViewer>
                                <StackPanel Spacing="15" Margin="0,15,10,0">
                                    <TextBlock Text="Rutas de ROM / Ejecutables" FontSize="11" Foreground="#64748b"/>
                                    <ListBox Name="LstRoms" Height="120" Background="#0f172a" CornerRadius="8" BorderThickness="1" BorderBrush="#334155">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#cbd5e1" FontSize="12" Padding="5"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid ColumnDefinitions="*, *">
                                        <Button Name="BtnAddRom" Grid.Column="0" Content="+ Añadir Disco/ROM" HorizontalAlignment="Stretch" Margin="0,0,5,0" Click="BtnAddRom_Click"/>
                                        <Button Name="BtnRemoveRom" Grid.Column="1" Content="- Quitar Seleccionado" HorizontalAlignment="Stretch" Margin="5,0,0,0" Foreground="#ef4444" Click="BtnRemoveRom_Click"/>
                                    </Grid>

                                    <Separator Background="#334155" Margin="0,5"/>
                                    
                                    <TextBlock Text="Configuración de Lanzamiento" FontSize="11" Foreground="#64748b" FontWeight="Bold"/>

                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Emulador personalizado (Override)" FontSize="11" Foreground="#64748b"/>
                                        <DockPanel>
                                            <Button Name="BtnSelectOverrideEmulator" Content="Buscar..." DockPanel.Dock="Right" Margin="5,0,0,0" Click="BtnSelectOverrideEmulator_Click"/>
                                            <TextBox Name="TxtOverrideEmulator" PlaceholderText="Ruta al ejecutable .exe"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <StackPanel Spacing="5">
                                        <TextBlock Text="Argumentos personalizados" FontSize="11" Foreground="#64748b"/>
                                        <TextBox Name="TxtOverrideArgs" PlaceholderText="Ej: -L cores\snes9x_libretro.dll '{0}'"/>
                                        <TextBlock Text="Usa {0} como marcador de posición para la ruta de la ROM." FontSize="10" Foreground="#94a3b8" FontStyle="Italic"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- PESTAÑA 4: MULTIMEDIA -->
                        <TabItem Header="Multimedia">
                            <ScrollViewer>
                                <StackPanel Spacing="15" Margin="0,15,10,0">
                                    <TextBlock Text="Gestión de Arte" FontSize="11" Foreground="#64748b"/>
                                    
                                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="10">
                                            <TextBlock Text="Carátula Principal" FontSize="13" Foreground="White" FontWeight="Bold"/>
                                            <TextBlock Text="Esta imagen se usará en la rejilla y en el panel lateral." FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                                                <Button Name="BtnSelectCover" Content="📁 Seleccionar..." Click="BtnSelectCover_Click"/>
                                                <Button Name="BtnClearCover" Content="🗑️ Limpiar" Click="BtnClearCover_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <Border Grid.Row="0" Grid.Column="1" Background="#0f172a" Width="120" Height="160" CornerRadius="8" BorderThickness="1" BorderBrush="#334155">
                                            <Panel>
                                                <TextBlock Text="Sin Imagen" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#334155" FontSize="10"/>
                                                <Image Name="ImgEditCover" Stretch="Uniform" Margin="5"/>
                                            </Panel>
                                        </Border>
                                    </Grid>

                                    <Separator Background="#334155" Margin="0,5"/>
                                    
                                    <TextBlock Text="Arte Adicional (Fondo / Logo)" FontSize="13" Foreground="White" FontWeight="Bold"/>
                                    <TextBlock Text="El sistema busca automáticamente Fanart y Clear Logo en las subcarpetas del sistema." FontSize="11" Foreground="#94a3b8" TextWrapping="Wrap"/>
                                    
                                    <StackPanel Spacing="5" Margin="0,5,0,0">
                                        <TextBlock Text="Tipo de Arte Preferido" FontSize="11" Foreground="#64748b"/>
                                        <ComboBox Name="CmbEditArtType" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="Box 3D"/>
                                            <ComboBoxItem Content="Box Full"/>
                                            <ComboBoxItem Content="Cart - Front"/>
                                            <ComboBoxItem Content="Cart - 3D"/>
                                            <ComboBoxItem Content="Support"/>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        
                        <!-- PESTAÑA 5: DESCRIPCIÓN -->
                        <TabItem Header="Descripción">
                            <ScrollViewer>
                                <StackPanel Spacing="10" Margin="0,15,10,0">
                                    <TextBlock Text="Descripción del Juego" FontSize="11" Foreground="#64748b"/>
                                    <TextBox Name="TxtDescription" AcceptsReturn="True" TextWrapping="Wrap" Height="300" 
                                             PlaceholderText="Escribe aquí la historia o detalles del juego..."
                                             Background="#0f172a" BorderBrush="#334155" Foreground="White" Padding="10"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Border>

        <Border Name="OverlayFullStats" Background="#AA000000" IsVisible="False" ZIndex="160">
            <Border Background="#1e293b" Width="600" Height="650" Padding="35" CornerRadius="15" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 10 30 0 #55000000">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*, Auto" Margin="0,0,0,25">
                        <TextBlock Text="ESTADÍSTICAS DE COLECCIÓN" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Name="BtnCloseFullStats" Grid.Column="1" Content="✕" Background="Transparent" Foreground="#ef4444" FontSize="20" Padding="10"/>
                    </Grid>
                    
                    <ScrollViewer>
                        <StackPanel Spacing="25">
                            <!-- Global Counters -->
                            <Grid ColumnDefinitions="*, *, *">
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="JUEGOS" Foreground="#94a3b8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Name="FullStatsTotalGames" FontSize="32" FontWeight="ExtraBold" Foreground="#10b981" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="SISTEMAS" Foreground="#94a3b8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Name="FullStatsTotalPlatforms" FontSize="32" FontWeight="ExtraBold" Foreground="#3b82f6" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="GÉNEROS" Foreground="#94a3b8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Name="FullStatsTotalGenres" FontSize="32" FontWeight="ExtraBold" Foreground="#f59e0b" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <Separator Background="#334155" Margin="0,5"/>

                            <!-- List by Platform -->
                            <StackPanel Spacing="10">
                                <TextBlock Text="DISTRIBUCIÓN POR PLATAFORMA" Foreground="#64748b" FontSize="11" FontWeight="Bold"/>
                                <ListBox Name="FullStatsPlatformList" Height="180" Background="#0f172a" CornerRadius="8" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:CompileBindings="False">
                                            <Grid ColumnDefinitions="*, Auto" Margin="0,2">
                                                <TextBlock Text="{Binding Key}" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Background="#334155" CornerRadius="12" Padding="10,2">
                                                    <TextBlock Text="{Binding Value}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>

                            <!-- List by Region -->
                            <StackPanel Spacing="10">
                                <TextBlock Text="JUEGOS POR REGIÓN" Foreground="#64748b" FontSize="11" FontWeight="Bold"/>
                                <ListBox Name="FullStatsRegionList" Height="150" Background="#0f172a" CornerRadius="8" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:CompileBindings="False">
                                            <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,2">
                                                <Image Source="{Binding Key, Converter={StaticResource RegionToFlag}}" Width="24" Height="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Key}" Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Value}" Foreground="#10b981" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <Border Name="OverlayProgress" Background="#AA000000" IsVisible="False" ZIndex="200">
            <Border Background="#1e293b" Width="400" Padding="30" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Spacing="15"><TextBlock Name="TxtProgressTitle" FontWeight="Bold"/><ProgressBar Name="ProgBarImport" Height="15"/><TextBlock Name="TxtProgressDetail"/><Button Name="BtnCancelProgress" Content="CANCELAR" Background="#ef4444" HorizontalAlignment="Center"/></StackPanel></Border>
        </Border>

        <Border Name="OverlayMessage" Background="#AA000000" IsVisible="False" ZIndex="300">
            <Border Background="#1e293b" Width="400" Padding="30" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="20">
                    <TextBlock Name="TxtMessageContent" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <Button Name="BtnCloseMessage" Content="ACEPTAR" Background="#10b981" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Padding="30,10" Click="BtnCloseMessage_Click"/>
                </StackPanel>
            </Border>
        </Border>

        <Border Name="OverlayConfirm" Background="#AA000000" IsVisible="False" ZIndex="350">
            <Border Background="#1e293b" Width="400" Padding="30" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="20">
                    <TextBlock Name="TxtConfirmTitle" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center"/>
                    <TextBlock Name="TxtConfirmContent" TextWrapping="Wrap" TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15">
                        <Button Name="BtnCancelConfirm" Content="CANCELAR" Click="BtnCancelConfirm_Click"/>
                        <Button Name="BtnAcceptConfirm" Content="ACEPTAR" Background="#ef4444" Foreground="White" Click="BtnAcceptConfirm_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border Name="OverlayExportOptions" Background="#AA000000" IsVisible="False" ZIndex="100">
            <Border Background="#1e293b" Width="400" Padding="30" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="15">
                    <TextBlock Text="Opciones de Exportación" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                    <CheckBox Name="ChkExportGames" Content="Juegos (Base de Datos Principal)"/>
                    <CheckBox Name="ChkExportCovers" Content="Carátulas (Base de Datos Multimedia)"/>
                    <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
                        <Button Name="BtnCancelExport" Content="CANCELAR" Grid.Column="0" HorizontalAlignment="Stretch" Margin="0,0,5,0" Click="BtnCancelExport_Click"/>
                        <Button Name="BtnConfirmExport" Content="EXPORTAR" Grid.Column="1" HorizontalAlignment="Stretch" Margin="5,0,0,0" Background="#3b82f6" Foreground="White" Click="BtnConfirmExport_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <Border Name="OverlayVimmSystem" Background="#AA000000" IsVisible="False" ZIndex="100">
            <Border Background="#1e293b" Width="400" Padding="30" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="15">
                    <TextBlock Text="Seleccionar Sistema en Vimm's Lair" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                    <ComboBox Name="CmbVimmSystem" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:CompileBindings="False">
                                <TextBlock Text="{Binding Key}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
                        <Button Name="BtnCancelVimm" Content="CANCELAR" Grid.Column="0" HorizontalAlignment="Stretch" Margin="0,0,5,0" Click="BtnCancelVimm_Click"/>
                        <Button Name="BtnConfirmVimm" Content="CONFIRMAR" Grid.Column="1" HorizontalAlignment="Stretch" Margin="5,0,0,0" Background="#10b981" Foreground="White" Click="BtnConfirmVimm_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <Border Name="OverlayAddPlatform" Background="#AA000000" IsVisible="False" ZIndex="100">
            <Border Background="#1e293b" Width="400" Padding="30" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="15">
                    <TextBlock Text="Nueva Plataforma" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center"/>
                    <TextBox Name="TxtNewPlatformName" PlaceholderText="Nombre de la consola"/>
                    <ComboBox Name="CmbNewPlatformCategory" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Consoles"/>
                        <ComboBoxItem Content="Handhelds"/>
                        <ComboBoxItem Content="Computers"/>
                        <ComboBoxItem Content="Arcade"/>
                    </ComboBox>
                    <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
                        <Button Name="BtnCancelPlatform" Content="CANCELAR" Grid.Column="0" HorizontalAlignment="Stretch" Margin="0,0,5,0" Click="BtnCancelPlatform_Click"/>
                        <Button Name="BtnSavePlatform" Content="GUARDAR" Grid.Column="1" HorizontalAlignment="Stretch" Margin="5,0,0,0" Background="#10b981" Foreground="White" Click="BtnSavePlatform_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <Border Name="OverlayManagePlatforms" Background="#AA000000" IsVisible="False" ZIndex="100">
            <Border Background="#1e293b" Width="650" Height="550" Padding="30" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <Button Name="BtnCloseManagePlatforms" DockPanel.Dock="Top" Content="✕" Background="Transparent" Foreground="#ef4444" FontSize="20" HorizontalAlignment="Right" Margin="0,0,0,20"/>
                    <Grid ColumnDefinitions="200, *">
                        <ListBox Name="LstManagePlatforms" Background="#0f172a" CornerRadius="8" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:Platform">
                                    <TextBlock Text="{Binding Name}" Foreground="White" Padding="5"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Column="1" Name="PnlEditPlatform" IsVisible="False" Spacing="10" Margin="20,0,0,0">
                            <TextBlock Text="Nombre de la Plataforma" FontSize="11" Foreground="#64748b"/>
                            <TextBox Name="TxtEditPlatformName"/>
                            <TextBlock Text="Categoría" FontSize="11" Foreground="#64748b"/>
                            <ComboBox Name="CmbEditPlatformCategory" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Consoles"/><ComboBoxItem Content="Handhelds"/><ComboBoxItem Content="Computers"/><ComboBoxItem Content="Arcade"/>
                            </ComboBox>
                            <TextBlock Text="Ruta del Emulador" FontSize="11" Foreground="#64748b"/>
                            <DockPanel>
                                <Button Name="BtnSelectEmulator" Content="..." DockPanel.Dock="Right"/>
                                <TextBox Name="TxtEmulatorPath"/>
                            </DockPanel>
                            <TextBlock Text="Argumentos de Lanzamiento" FontSize="11" Foreground="#64748b"/>
                            <TextBox Name="TxtLaunchArgs"/>
                            <Grid ColumnDefinitions="*,*" Margin="0,20,0,0">
                                <Button Name="BtnDeletePlatform" Grid.Column="0" Content="Eliminar" Background="#ef4444" Margin="0,0,5,0" HorizontalAlignment="Stretch"/>
                                <Button Name="BtnSaveEditPlatform" Grid.Column="1" Content="Guardar" Background="#10b981" Margin="5,0,0,0" HorizontalAlignment="Stretch"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Border>

        <Border Name="OverlaySettings" Background="#AA000000" IsVisible="False" ZIndex="100">
            <Border Background="#1e293b" Width="500" Padding="30" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="15">
                    <TextBlock Text="Ruta de LaunchBox" Foreground="#64748b" FontSize="12"/>
                    <DockPanel>
                        <Button Name="BtnBrowseLb" Content="..." DockPanel.Dock="Right" Click="BtnBrowseLb_Click"/>
                        <TextBox Name="CfgLbPath" Text="{Binding #CfgLbPath.Text}"/>
                    </DockPanel>

                    <TextBlock Text="Tipo de Arte Preferido" Foreground="#64748b" FontSize="12"/>
                    <ComboBox Name="CfgArtType" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Advert"/>
                        <ComboBoxItem Content="Artwork Preview"/>
                        <ComboBoxItem Content="Background"/>
                        <ComboBoxItem Content="Box"/>
                        <ComboBoxItem Content="Box Full"/>
                        <ComboBoxItem Content="Box 3D"/>                        <ComboBoxItem Content="Cabinet"/>
                        <ComboBoxItem Content="Logos"/>
                        <ComboBoxItem Content="Marquee"/>
                        <ComboBoxItem Content="Snap"/>
                        <ComboBoxItem Content="System Logo"/>
                        <ComboBoxItem Content="Title"/>
                    </ComboBox>

                    <CheckBox Name="CfgAutoImportCovers" Content="Importar carátulas automáticamente"/>
                    <CheckBox Name="CfgEnableSoundEffects" Content="Activar efectos de sonido (SFX)"/>

                    <Grid ColumnDefinitions="*,*" Margin="0,10,0,0">
                        <Button Name="BtnCancelSettings" Content="CANCELAR" Grid.Column="0" HorizontalAlignment="Stretch" Margin="0,0,5,0" Click="BtnCancelSettings_Click"/>
                        <Button Name="BtnSaveSettings" Content="GUARDAR" Grid.Column="1" HorizontalAlignment="Stretch" Margin="5,0,0,0" Background="#10b981" Click="BtnSaveSettings_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
        <Border Name="OverlayKeyboard" Background="#AA000000" IsVisible="False" ZIndex="500">
            <Border Background="#0f172a" Width="800" Padding="20" CornerRadius="15"><StackPanel Spacing="20"><TextBox Name="TxtKeyboardInput"/><Grid Name="GridKeyboard"/></StackPanel></Border>
        </Border>

        <Border Name="OverlayPlatformsWall" Background="#AA000000" IsVisible="False" ZIndex="100">
            <Border Background="#0f172a" Margin="50" CornerRadius="20" Padding="30">
                <DockPanel>
                    <Button Name="BtnClosePlatformsWall" DockPanel.Dock="Top" Content="✕" Background="Transparent" Foreground="#ef4444" FontSize="20" HorizontalAlignment="Right" Margin="0,0,0,20"/>
                    <ListBox Name="LstPlatformsWall" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:Platform">
                                <Border Background="#1e293b" Margin="10" Padding="20" CornerRadius="15" Width="220" Height="160">
                                    <StackPanel VerticalAlignment="Center">
                                        <Panel Height="80">
                                            <Image Source="{Binding Logo, Converter={StaticResource ByteToBitmap}}" Stretch="Uniform"/>
                                            <TextBlock Text="🎮" FontSize="50" HorizontalAlignment="Center" Opacity="0.1" VerticalAlignment="Center"/>
                                        </Panel>
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,15,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Border>
        
        <Border Name="OverlayIgdbSearch" Background="#AA000000" IsVisible="False" ZIndex="400">
            <Border Background="#1e293b" Width="550" Height="500" Padding="25" CornerRadius="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock Name="TxtIgdbStatus" DockPanel.Dock="Top" Foreground="#94a3b8" Margin="0,0,0,15"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
                        <Button Name="BtnCancelIgdb" Content="CANCELAR" Padding="20,10"/>
                        <Button Name="BtnSelectIgdb" Content="SELECCIONAR" Background="#10b981" Foreground="White" FontWeight="Bold" Padding="20,10"/>
                    </StackPanel>
                    <ListBox Name="LstIgdbResults" Background="#0f172a" CornerRadius="8" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="services:IgdbSearchResult">
                                <Grid ColumnDefinitions="Auto, *" Margin="5">
                                    <Border Grid.Column="0" Background="#1e293b" Width="40" Height="40" CornerRadius="4" Margin="0,0,10,0">
                                        <TextBlock Text="🎮" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.5"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Year}" Foreground="#64748b" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Border>

    </Grid>
</Window>
