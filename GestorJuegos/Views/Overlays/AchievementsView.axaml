<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:GestorJuegos.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="GestorJuegos.Views.Overlays.AchievementsView">

    <UserControl.Styles>
        <!-- Estilos para regular la opacidad de los iconos según su estado de desbloqueo -->
        <Style Selector="Image.AchievementIcon">
            <Setter Property="Opacity" Value="0.3"/>
        </Style>
        <Style Selector="Image.AchievementIcon.Unlocked">
            <Setter Property="Opacity" Value="1.0"/>
        </Style>

        <!-- Estilos de botón de cierre redondo premium -->
        <Style Selector="Button#BtnClose">
            <Setter Property="Background" Value="#2d2f36"/>
            <Setter Property="Foreground" Value="#9e9ea6"/>
        </Style>
        <Style Selector="Button#BtnClose:pointerover">
            <Setter Property="Background" Value="#3a3c45"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>

    <Panel Background="#a5000000"> <!-- Fondo oscurecido semitransparente que cubre la aplicación -->
        
        <!-- Contenedor flotante a la derecha idéntico al de LaunchBox -->
        <Border Background="#212226" 
                Width="420" 
                CornerRadius="24,0,0,24" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Stretch"
                BorderBrush="#33353b"
                BorderThickness="1,0,0,0"
                Padding="25,20"
                BoxShadow="-6 0 24 0 #d0000000">
            
            <Grid RowDefinitions="Auto, *">
                
                <!-- Cabecera -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,5,0,20">
                    <!-- Botón de cierre redondo con la X a la izquierda -->
                    <Button Grid.Column="0" 
                            Name="BtnClose" 
                            Width="32" 
                            Height="32" 
                            CornerRadius="16" 
                            Padding="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <TextBlock Text="✕" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <!-- Título centrado visualmente -->
                    <TextBlock Grid.Column="1"
                               Text="RETRO ACHIEVEMENTS" 
                               FontSize="17" 
                               FontWeight="Heavy" 
                               Foreground="#e2e8f0" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               LetterSpacing="1.2"
                               Margin="0,0,32,0"/> <!-- Margen derecho para compensar el botón de la izquierda -->
                </Grid>


                <!-- Listado de logros con scroll -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsControl Name="ItemsAchievementsList" x:CompileBindings="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,10" Background="Transparent">
                                    
                                    <!-- Icono del logro con borde sutil -->
                                    <Border Grid.Column="0" 
                                            Width="62" 
                                            Height="62" 
                                            CornerRadius="8" 
                                            ClipToBounds="True" 
                                            BorderBrush="#3e4046" 
                                            BorderThickness="1.2"
                                            Background="#151517">
                                        <Image Classes="AchievementIcon"
                                               Classes.Unlocked="{Binding IsUnlocked}"
                                               Source="{Binding IconUrl, Converter={StaticResource UrlToBitmap}}" 
                                               Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- Textos (Título y Descripción) -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,5,0">
                                        <TextBlock Text="{Binding Title}" 
                                                   Foreground="#f8fafc" 
                                                   FontWeight="Bold" 
                                                   FontSize="13.5" 
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Description}" 
                                                   Foreground="#7f818a" 
                                                   FontSize="11.5" 
                                                   TextWrapping="Wrap" 
                                                   Margin="0,4,0,0" 
                                                   LineHeight="16"/>
                                    </StackPanel>

                                    <!-- Indicador de Estado a la derecha -->
                                    <Panel Grid.Column="2" VerticalAlignment="Center" Width="24" Height="24" Margin="5,0,0,0">
                                        
                                        <!-- Estado Desbloqueado Normal (Círculo azul con check blanco) -->
                                        <Border Width="22" 
                                                Height="22" 
                                                CornerRadius="11" 
                                                Background="#1b365d" 
                                                BorderBrush="#3182ce" 
                                                BorderThickness="1.5"
                                                IsVisible="{Binding IsNormalUnlock}"
                                                ToolTip.Tip="Desbloqueado">
                                            <TextBlock Text="✓" 
                                                       Foreground="#63b3ed" 
                                                       FontSize="11" 
                                                       FontWeight="Bold" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center" 
                                                       Margin="0,-1,0,0"/>
                                        </Border>

                                        <!-- Estado Desbloqueado Victoria/Hardcore (Icono de Insignia/Medalla) -->
                                        <!-- Usamos un círculo dorado con una estrella blanca para simular la insignia -->
                                        <Border Width="22" 
                                                Height="22" 
                                                CornerRadius="11" 
                                                Background="#2c5282" 
                                                BorderBrush="#4299e1" 
                                                BorderThickness="1.5"
                                                IsVisible="{Binding IsWinUnlock}"
                                                ToolTip.Tip="Victoria / Logro de Historia">
                                            <TextBlock Text="★" 
                                                       Foreground="#90cdf4" 
                                                       FontSize="10" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center" 
                                                       Margin="0,-0.5,0,0"/>
                                        </Border>
                                    </Panel>
                                    
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                
            </Grid>
        </Border>
    </Panel>
</UserControl>
