<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="250"
             x:Class="GestorJuegos.Views.Overlays.SimpleDialogView">

    <Panel Background="#AA000000">
        <Border Background="{DynamicResource PanelBrush}" Width="400" Padding="30" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 10 30 0 #AA000000">
            <StackPanel Spacing="20">
                <TextBlock Name="TxtTitle" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Foreground="White" IsVisible="False"/>
                <TextBlock Name="TxtContent" TextWrapping="Wrap" TextAlignment="Center" Foreground="White"/>
                
                <StackPanel Name="PnlButtons" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15">
                    <Button Name="BtnCancel" Content="CANCELAR" IsVisible="False"/>
                    <Button Name="BtnAccept" Content="ACEPTAR" Background="#10b981" Foreground="White" FontWeight="Bold" Padding="20,8"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
