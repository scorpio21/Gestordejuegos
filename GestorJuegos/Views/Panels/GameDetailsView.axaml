<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:GestorJuegos.Models"
             xmlns:controls="clr-namespace:GestorJuegos.Controls"
             mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="800"
             x:Class="GestorJuegos.Views.Panels.GameDetailsView">
    <ScrollViewer>
        <Panel>
            <StackPanel Name="PnlGameDetails" Spacing="0">
                <StackPanel.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                    </Transitions>
                </StackPanel.Transitions>
                
                <!-- Banner Superior inmersivo estilo Biblioteca Externa -->
                <Panel Height="240">
                    <Border Background="{DynamicResource PanelBrush}" ClipToBounds="True">
                        <Image Name="ImgDetailBackground" Stretch="UniformToFill" Opacity="0.3">
                            <Image.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.5"/>
                                </Transitions>
                            </Image.Transitions>
                        </Image>
                    </Border>
                    
                    <!-- Gradiente para desvanecer con el fondo azul oscuro de la app -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Offset="0" Color="Transparent"/>
                                <GradientStop Offset="0.75" Color="#150f172a"/>
                                <GradientStop Offset="1" Color="{DynamicResource DeepDarkColor}"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Botón para ver imagen en pantalla completa -->
                    <Button Name="BtnViewFullArt" Background="#70000000" Foreground="White" Width="36" Height="36" CornerRadius="18" Margin="15" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="0" ToolTip.Tip="Ver Arte en Grande">
                        <TextBlock Text="↗" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                    </Button>

                    <!-- Botón flotante 'Ver todas las imágenes' -->
                    <Button Name="BtnViewAllImages" Background="#601e293b" BorderBrush="#33ffffff" BorderThickness="1" Foreground="White" CornerRadius="20" Padding="15,8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🖼️" VerticalAlignment="Center"/>
                            <TextBlock Text="Ver todas las imágenes" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Contenedor del Logo -->
                    <Border Name="BrdDetailLogo" 
                            Background="Transparent" 
                            VerticalAlignment="Bottom" HorizontalAlignment="Center"
                            Margin="0,0,0,35" 
                            Height="95" Width="260"
                            ZIndex="10">
                        <Image Name="ImgDetailLogo" Stretch="Uniform">
                            <Image.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.4"/>
                                </Transitions>
                            </Image.Transitions>
                        </Image>
                    </Border>

                    <!-- Calificación por Estrellas -->
                    <StackPanel Name="PnlRatingContainer" Orientation="Horizontal" Spacing="5" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="15,0,0,12">
                        <TextBlock Name="TxtInfoRatingText" Text="0.0" Foreground="#38bdf8" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Name="TxtInfoRatingStars" Text="☆☆☆☆☆" Foreground="#38bdf8" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Acciones Flotantes Rápidas -->
                    <Border Background="#600f172a" CornerRadius="18" Padding="3" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,15,10" BorderBrush="#20ffffff" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Name="BtnEditGame" Background="Transparent" Foreground="White" Width="32" Height="32" CornerRadius="16" Padding="0" ToolTip.Tip="Editar">
                                <TextBlock Text="✏️" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            </Button>
                            <Button Name="BtnFavoriteQuick" Background="Transparent" Foreground="#ef4444" Width="32" Height="32" CornerRadius="16" Padding="0" ToolTip.Tip="Favorito">
                                <TextBlock Name="TxtFavoriteIcon" Text="♡" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="Bold"/>
                            </Button>
                            <Button Name="BtnProgressQuick" Background="Transparent" Foreground="#eab308" Width="32" Height="32" CornerRadius="16" Padding="0" ToolTip.Tip="Progreso">
                                <TextBlock Text="✹" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="No Jugado" Tag="No Jugado"/>
                                        <MenuItem Header="Jugando" Tag="Jugando"/>
                                        <MenuItem Header="Completado" Tag="Completado"/>
                                        <MenuItem Header="Abandonado" Tag="Abandonado"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Name="BtnMoreOptions" Background="Transparent" Foreground="White" Width="32" Height="32" CornerRadius="16" Padding="0" ToolTip.Tip="Más opciones">
                                <TextBlock Text="•••" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="Abrir Carpeta">
                                            <MenuItem.Icon>
                                                <TextBlock Text="📁" VerticalAlignment="Center"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Borrar" Foreground="#ef4444">
                                            <MenuItem.Icon>
                                                <TextBlock Text="🗑️" Foreground="#ef4444" VerticalAlignment="Center"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Border>
                </Panel>

                <!-- Información de Título y Plataforma -->
                <StackPanel Spacing="5" Margin="20,15,20,5">
                    <StackPanel Orientation="Horizontal" Spacing="6" Opacity="0.8">
                        <TextBlock Text="🕹️" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Name="TxtInfoPlatform" Text="ARCADE" Foreground="#94a3b8" FontSize="11" FontWeight="Heavy" LetterSpacing="1" VerticalAlignment="Center" FontFamily="{DynamicResource MainFont}"/>
                    </StackPanel>
                    <TextBlock Name="TxtInfoName" FontSize="26" FontWeight="Black" Foreground="White" TextWrapping="Wrap" FontFamily="{DynamicResource HeaderFont}"/>
                </StackPanel>

                <!-- Pestañas de Detalle -->
                <TabControl Classes="Modern" Margin="10,0">
                    <TabItem Header="Descripción general">
                        <ScrollViewer Margin="0,10,0,0">
                            <StackPanel Spacing="20">
                                
                                <!-- IMAGEN PRINCIPAL (Visor 3D Interactivo) -->
                                <StackPanel Spacing="8" Margin="10,0,10,0">
                                    <TextBlock Text="VISOR 3D INTERACTIVO" Classes="Header" Foreground="#94a3b8" FontSize="11" FontWeight="Heavy"/>
                                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" ClipToBounds="True" Height="380" BoxShadow="0 4 12 0 #50000000">
                                        <Panel>
                                            <controls:GameBox3D 
                                                Name="ImgGameBox3D"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Width="220" 
                                                Height="300"/>
                                                
                                            <TextBlock Name="Txt3DHint" 
                                                       Text="🖱️ Clic derecho para girar" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Bottom" 
                                                       Margin="0,0,0,10" 
                                                       FontSize="10" 
                                                       Foreground="#60ffffff" 
                                                       IsHitTestVisible="False"/>
                                        </Panel>
                                    </Border>
                                </StackPanel>

                                <!-- Carrusel Horizontal de Capturas -->
                                <StackPanel Spacing="8" Margin="10,15,10,0">
                                    <TextBlock Text="IMÁGENES DEL JUEGO" Classes="Header" Foreground="#94a3b8" FontSize="11" FontWeight="Heavy"/>
                                    <ListBox Name="LstScreenshots" Background="Transparent" BorderThickness="0" Height="65">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="8"/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:GameImage">
                                                <Border CornerRadius="6" ClipToBounds="True" Width="85" Height="53" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <Image Source="{Binding ImageData, Converter={StaticResource ByteToBitmap}}" Stretch="UniformToFill"/>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                        </ListBox.Styles>
                                    </ListBox>
                                </StackPanel>

                                <!-- Botón JUGAR Gigante Verde -->
                                <Button Name="BtnLaunchGame" Background="#22c55e" Foreground="White" Height="52" CornerRadius="10" HorizontalAlignment="Stretch" Margin="10,0" Padding="0">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover">
                                            <Setter Property="Background" Value="#4ade80"/>
                                        </Style>
                                    </Button.Styles>
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Border Grid.Column="0" Background="#20000000" Width="52" CornerRadius="10,0,0,10">
                                            <TextBlock Text="▶" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="JUGAR" FontSize="18" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border Name="BdrRoms" Grid.Column="2" Background="#10000000" Width="40" CornerRadius="0,10,10,0">
                                            <TextBlock Text="▼" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <FlyoutBase.AttachedFlyout>
                                                <MenuFlyout>
                                                    <!-- Se rellena dinámicamente -->
                                                </MenuFlyout>
                                            </FlyoutBase.AttachedFlyout>
                                        </Border>
                                    </Grid>
                                </Button>

                                <!-- Información Básica -->
                                <Border Background="#101e293b" BorderBrush="#20334155" BorderThickness="0,1" Padding="10,15" Margin="10,0">
                                    <Grid RowDefinitions="Auto, Auto, Auto, Auto" ColumnDefinitions="Auto, *">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Fecha de lanzamiento" Foreground="#64748b" FontSize="12" Margin="0,0,0,10"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Name="TxtBaseReleaseDate" Text="--" Foreground="White" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Desarrollador" Foreground="#64748b" FontSize="12" Margin="0,0,0,10"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Name="TxtBaseDeveloper" Text="--" Foreground="White" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Editor" Foreground="#64748b" FontSize="12" Margin="0,0,0,10"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Name="TxtBasePublisher" Text="--" Foreground="White" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Tiempo Jugado" Foreground="#64748b" FontSize="12"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Name="TxtBasePlaytime" Text="0h 00m 00s (0)" Foreground="White" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>

                                <!-- Selector de Tipo de Arte Principal -->
                                <StackPanel Spacing="5" Margin="10,0">
                                    <TextBlock Text="TIPO DE CARÁTULA / MULTIMEDIA" Classes="Header" Foreground="#64748b" FontSize="11" FontWeight="Bold"/>
                                    <ComboBox Name="CmbArtType" SelectedIndex="3" HorizontalAlignment="Stretch" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}">
                                        <ComboBoxItem Content="Advert"/>
                                        <ComboBoxItem Content="Artwork Preview"/>
                                        <ComboBoxItem Content="Background"/>
                                        <ComboBoxItem Content="Box"/>
                                        <ComboBoxItem Content="Box Full"/>
                                        <ComboBoxItem Content="Box 3D"/>
                                        <ComboBoxItem Content="Cabinet"/>
                                        <ComboBoxItem Content="Logos"/>
                                        <ComboBoxItem Content="Marquee"/>
                                        <ComboBoxItem Content="Snap"/>
                                        <ComboBoxItem Content="System Logo"/>
                                        <ComboBoxItem Content="Title"/>
                                    </ComboBox>
                                    
                                    <!-- Visor de Carátulas -->
                                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" MinHeight="250" MaxHeight="350" ClipToBounds="True" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,10,0,0">
                                        <Image Name="ImgCover" Stretch="Uniform" Margin="10">
                                            <Image.Transitions>
                                                <Transitions>
                                                    <DoubleTransition Property="Opacity" Duration="0:0:0.4"/>
                                                </Transitions>
                                            </Image.Transitions>
                                        </Image>
                                    </Border>
                                </StackPanel>

                                <!-- Información Detallada -->
                                <StackPanel Spacing="8" Margin="10,0">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Grid.Column="0" Text="INFORMACIÓN" Classes="Header" Foreground="#94a3b8" FontSize="11" FontWeight="Heavy"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Opacity="0.7">
                                            <Button Name="BtnWikiUrl" Background="Transparent" Padding="0" ToolTip.Tip="Visitar Wikipedia del juego" IsVisible="False">
                                                <TextBlock Text="🌐" FontSize="14" Foreground="#38bdf8"/>
                                            </Button>
                                            <Button Name="BtnVideoUrl" Background="Transparent" Padding="0" ToolTip.Tip="Ver video/tráiler" IsVisible="False">
                                                <TextBlock Text="▶" Foreground="#ef4444" FontSize="14"/>
                                            </Button>
                                            <Button Name="BtnWikiSearch" Background="Transparent" Padding="0" ToolTip.Tip="Buscar en Wikipedia (Genérico)">
                                                <TextBlock Text="🔍" FontSize="14" Foreground="#94a3b8"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="{DynamicResource PanelBrush}" Padding="15" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                         <StackPanel Spacing="10">
                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoEsrb" Text="--" Foreground="White" DockPanel.Dock="Right" FontSize="12" FontWeight="Medium"/>
                                                 <TextBlock Text="Clasificación" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                             <Separator Background="#15ffffff"/>
                                             
                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoGenre" Text="--" Foreground="White" DockPanel.Dock="Right" FontSize="12" FontWeight="Medium"/>
                                                 <TextBlock Text="Género" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                             <Separator Background="#15ffffff"/>

                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoPlayMode" Text="--" Foreground="White" DockPanel.Dock="Right" FontSize="12" FontWeight="Medium"/>
                                                 <TextBlock Text="Modo de Juego" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                             <Separator Background="#15ffffff"/>

                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoProgress" Text="No Jugado" Foreground="#f59e0b" DockPanel.Dock="Right" FontSize="12" FontWeight="Medium"/>
                                                 <TextBlock Text="Progress" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                             <Separator Background="#15ffffff"/>

                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoRegion" Text="--" Foreground="White" DockPanel.Dock="Right" FontSize="12" FontWeight="Medium"/>
                                                 <TextBlock Text="Región" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                             <Separator Background="#15ffffff"/>

                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoStatus" Text="--" Foreground="White" DockPanel.Dock="Right" FontSize="12" FontWeight="Medium"/>
                                                 <TextBlock Text="Estado" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                             <Separator Background="#15ffffff"/>

                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoPortable" Text="No" Foreground="White" DockPanel.Dock="Right" FontSize="12" FontWeight="Medium"/>
                                                 <TextBlock Text="Portable" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                             <Separator Background="#15ffffff"/>

                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoFile" Text="--" Foreground="#38bdf8" DockPanel.Dock="Right" FontSize="11" TextWrapping="Wrap" MaxWidth="180"/>
                                                 <TextBlock Text="Archivo" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                             <Separator Background="#15ffffff"/>

                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoLastPlayed" Text="Nunca" Foreground="White" DockPanel.Dock="Right" FontSize="12"/>
                                                 <TextBlock Text="Última vez jugado" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                             <Separator Background="#15ffffff"/>

                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoReleaseDate" Text="--" Foreground="White" DockPanel.Dock="Right" FontSize="12" FontWeight="Medium"/>
                                                 <TextBlock Text="Fecha de Lanzamiento" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                             <Separator Background="#15ffffff"/>

                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoReleaseType" Text="--" Foreground="White" DockPanel.Dock="Right" FontSize="12" FontWeight="Medium"/>
                                                 <TextBlock Text="Tipo de Lanzamiento" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                             <Separator Background="#15ffffff"/>

                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoMaxPlayers" Text="--" Foreground="White" DockPanel.Dock="Right" FontSize="12" FontWeight="Medium"/>
                                                 <TextBlock Text="Cantidad Máx. de Jugadores" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                         </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Descripción -->
                                <StackPanel Spacing="8" Margin="10,0,10,0">
                                    <TextBlock Text="DESCRIPCIÓN" Classes="Header" Foreground="#94a3b8" FontSize="11" FontWeight="Heavy"/>
                                    <Border Background="{DynamicResource PanelBrush}" Padding="15" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <TextBlock Name="TxtInfoDescription" Foreground="#cbd5e1" FontSize="13" TextWrapping="Wrap" Opacity="0.95" LineHeight="20"/>
                                    </Border>
                                </StackPanel>

                                <!-- Playtime Commitment -->
                                <StackPanel Spacing="8" Margin="10,16,10,20">
                                    <TextBlock Text="PLAYTIME COMMITMENT" Classes="Header" Foreground="#94a3b8" FontSize="11" FontWeight="Heavy"/>
                                    <Border Background="{DynamicResource PanelBrush}" Padding="15" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Grid ColumnDefinitions="*, *, *">
                                            <StackPanel Grid.Column="0" Spacing="4" HorizontalAlignment="Center">
                                                <TextBlock Text="HISTORIA" Foreground="#64748b" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Name="TxtPlaytimeMain" Text="--" Foreground="#00a2ff" FontSize="16" FontWeight="Heavy" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Mínimo" Foreground="#475569" FontSize="9" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Center">
                                                <TextBlock Text="HISTORIA + EXTRA" Foreground="#64748b" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Name="TxtPlaytimeExtra" Text="--" Foreground="#10b981" FontSize="16" FontWeight="Heavy" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Promedio" Foreground="#475569" FontSize="9" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Center">
                                                <TextBlock Text="COMPLETISTA" Foreground="#64748b" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                <TextBlock Name="TxtPlaytimeCompletionist" Text="--" Foreground="#f59e0b" FontSize="16" FontWeight="Heavy" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Máximo" Foreground="#475569" FontSize="9" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Retro Achievements -->
                                <StackPanel Spacing="8" Margin="10,0,10,20" Name="PanelAchievementsSmall">
                                    <TextBlock Name="TxtAchievementsTitle" Text="RETRO ACHIEVEMENTS (0/0)" Classes="Header" Foreground="#94a3b8" FontSize="11" FontWeight="Heavy"/>
                                    <Border Background="#28282C" Padding="15" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="12">
                                            <ProgressBar Name="ProgAchievements" Value="0" Maximum="100" Height="4" Background="#1e1e22" Foreground="#00a2ff" CornerRadius="2"/>
                                            <Grid ColumnDefinitions="*, Auto">
                                                <StackPanel Name="StackAchievementIcons" Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="No hay logros disponibles" Foreground="#475569" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Name="BtnExpandAchievements" Content="Expandir"
                                                        Padding="12,4" FontSize="10" FontWeight="Bold"
                                                        Background="Transparent" BorderBrush="#475569" BorderThickness="1" CornerRadius="15"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    
                    <TabItem Header="Juegos Relacionados">
                        <ScrollViewer Margin="0,10,0,0">
                            <StackPanel Spacing="15" Margin="10,0,10,20">
                                <TextBlock Text="JUEGOS DE LA MISMA PLATAFORMA" Classes="Header" Foreground="#94a3b8" FontSize="11" FontWeight="Heavy" Margin="0,0,0,5"/>
                                
                                <ListBox Name="LstRelatedGames" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:Game">
                                            <Border Background="{DynamicResource PanelBrush}" Margin="0,0,0,8" Padding="8" CornerRadius="8" BorderBrush="#20334155" BorderThickness="1">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <Image Grid.Column="0" Source="{Binding Cover, Converter={StaticResource ByteToBitmap}}" Width="45" Height="65" Stretch="UniformToFill" Margin="0,0,12,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="13" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Genre}" Foreground="#64748b" FontSize="11"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Year}" Foreground="#94a3b8" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                
                                <TextBlock Name="TxtNoRelatedGames" Text="No se encontraron juegos relacionados." Foreground="#64748b" FontSize="12" HorizontalAlignment="Center" IsVisible="False" Margin="0,20,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </Panel>
    </ScrollViewer>
</UserControl>