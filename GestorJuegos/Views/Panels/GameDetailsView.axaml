<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:GestorJuegos.Models"
             xmlns:controls="clr-namespace:GestorJuegos.Controls"
             mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="800"
             x:Class="GestorJuegos.Views.Panels.GameDetailsView">
    
    <UserControl.Styles>
        <Style Selector="ItemsControl#ItemsRatingStars Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="TextBlock.StarIcon" x:DataType="models:StarItem">
            <Setter Property="Foreground" Value="{Binding Color}"/>
        </Style>
        <Style Selector="ItemsControl#ItemsRatingStars Button:pointerover TextBlock.StarIcon">
            <Setter Property="Foreground" Value="#f59e0b"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer>
        <Panel>
            <StackPanel Name="PnlGameDetails" Spacing="0">
                <StackPanel.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.3"/>
                    </Transitions>
                </StackPanel.Transitions>
                
                <Panel Height="240">
                    <Border Background="{DynamicResource PanelBrush}" ClipToBounds="True">
                        <Image Name="ImgDetailBackground" Stretch="UniformToFill" Opacity="0.3">
                            <Image.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.5"/>
                                </Transitions>
                            </Image.Transitions>
                        </Image>
                    </Border>
                    
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                <GradientStop Offset="0" Color="Transparent"/>
                                <GradientStop Offset="0.75" Color="#150f172a"/>
                                <GradientStop Offset="1" Color="{DynamicResource DeepDarkColor}"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Button Name="BtnViewFullArt" Background="#70000000" Foreground="White" Width="36" Height="36" CornerRadius="18" Margin="15" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="0">
                        <TextBlock Text="↗" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>
                    </Button>

                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="15">
                        <Button Click="OnWikiSearchClick" Background="#70000000" Foreground="White" Width="36" Height="36" CornerRadius="18" Padding="0">
                            <TextBlock Text="🔍" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                        </Button>
                    </StackPanel>

                    <Border Name="BrdDetailLogo" 
                            Background="Transparent" 
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Height="95" Width="260"
                            ZIndex="10">
                        <Image Name="ImgDetailLogo" Stretch="Uniform"/>
                    </Border>

                    <Button Name="BtnViewAllImages" Background="#601e293b" BorderBrush="#33ffffff" BorderThickness="1" Foreground="White" CornerRadius="20" Padding="15,8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🖼️" VerticalAlignment="Center"/>
                            <TextBlock Text="Ver todas las imágenes" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Name="PnlRatingContainer" Orientation="Horizontal" Spacing="5" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="15,0,0,12">
                        <TextBlock Name="TxtInfoRatingText" Text="0.0" Foreground="#38bdf8" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        <ItemsControl Name="ItemsRatingStars">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:StarItem">
                                    <Button Click="OnStarClick" Tag="{Binding}"><TextBlock Text="{Binding StarChar}" Classes="StarIcon" FontSize="16"/></Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Background="#600f172a" CornerRadius="18" Padding="3" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,15,10" BorderBrush="#20ffffff" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Name="BtnEditGame" Background="Transparent" Foreground="White" Width="32" Height="32" CornerRadius="16" Padding="0"><TextBlock Text="✏️" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/></Button>
                            <Button Name="BtnFavoriteQuick" Background="Transparent" Foreground="#ef4444" Width="32" Height="32" CornerRadius="16" Padding="0"><TextBlock Name="TxtFavoriteIcon" Text="♡" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="Bold"/></Button>
                            <Button Name="BtnProgressQuick" Background="Transparent" Foreground="#eab308" Width="32" Height="32" CornerRadius="16" Padding="0">
                                <TextBlock Text="✹" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                                <Button.Flyout><MenuFlyout><MenuItem Header="No Jugado" Tag="No Jugado"/><MenuItem Header="Jugando" Tag="Jugando"/><MenuItem Header="Completado" Tag="Completado"/><MenuItem Header="Abandonado" Tag="Abandonado"/></MenuFlyout></Button.Flyout>
                            </Button>
                            <Button Name="BtnMoreOptions" Background="Transparent" Foreground="White" Width="32" Height="32" CornerRadius="16" Padding="0">
                                <TextBlock Text="•••" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                <Button.Flyout><MenuFlyout><MenuItem Header="Abrir Carpeta"/><Separator/><MenuItem Header="Borrar" Foreground="#ef4444"/></MenuFlyout></Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Border>
                </Panel>

                <StackPanel Spacing="5" Margin="20,15,20,5">
                    <StackPanel Orientation="Horizontal" Spacing="6" Opacity="0.8">
                        <TextBlock Text="🕹️" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Name="TxtInfoPlatform" Text="ARCADE" Foreground="#94a3b8" FontSize="11" FontWeight="Heavy" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Name="TxtInfoName" FontSize="26" FontWeight="Black" Foreground="White" TextWrapping="Wrap"/>
                </StackPanel>

                <TabControl Classes="Modern" Margin="10,0">
                    <TabItem Header="Detalles">
                        <ScrollViewer Margin="0,10,0,0">
                            <StackPanel Spacing="20">
                                <StackPanel Spacing="8" Margin="10,0">
                                    <TextBlock Text="VISOR 3D" Classes="Header" Foreground="#94a3b8" FontSize="11" FontWeight="Heavy"/>
                                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="10" ClipToBounds="True" Height="380">
                                        <controls:GameBox3D Name="ImgGameBox3D" HorizontalAlignment="Center" VerticalAlignment="Center" Width="220" Height="300"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Spacing="8" Margin="10,0">
                                    <TextBlock Text="CAPTURAS" Classes="Header" Foreground="#94a3b8" FontSize="11" FontWeight="Heavy"/>
                                    <ListBox Name="LstScreenshots" Background="Transparent" BorderThickness="0" Height="65">
                                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:GameImage"><Border CornerRadius="6" ClipToBounds="True" Width="85" Height="53"><Image Source="{Binding ImageData, Converter={StaticResource ByteToBitmap}}" Stretch="UniformToFill"/></Border></DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <Button Name="BtnLaunchGame" Background="#22c55e" Foreground="White" Height="52" CornerRadius="10" HorizontalAlignment="Stretch" Margin="10,0">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <Border Grid.Column="0" Background="#20000000" Width="52" CornerRadius="10,0,0,10"><TextBlock Text="▶" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <TextBlock Grid.Column="1" Text="JUGAR" FontSize="18" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Border Name="BdrRoms" Grid.Column="2" Background="#10000000" Width="40" CornerRadius="0,10,10,0"><TextBlock Text="▼" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    </Grid>
                                </Button>

                                <Border Background="#101e293b" Padding="10,15" Margin="10,0">
                                    <Grid RowDefinitions="Auto, Auto, Auto, Auto" ColumnDefinitions="Auto, *">
                                        <TextBlock Grid.Row="0" Text="Fecha" Foreground="#64748b" FontSize="12"/><TextBlock Grid.Row="0" Grid.Column="1" Name="TxtBaseReleaseDate" Text="--" Foreground="White" HorizontalAlignment="Right" FontSize="12"/>
                                        <TextBlock Grid.Row="1" Text="Desarrollador" Foreground="#64748b" FontSize="12"/><TextBlock Grid.Row="1" Grid.Column="1" Name="TxtBaseDeveloper" Text="--" Foreground="White" HorizontalAlignment="Right" FontSize="12"/>
                                        <TextBlock Grid.Row="2" Text="Editor" Foreground="#64748b" FontSize="12"/><TextBlock Grid.Row="2" Grid.Column="1" Name="TxtBasePublisher" Text="--" Foreground="White" HorizontalAlignment="Right" FontSize="12"/>
                                        <TextBlock Grid.Row="3" Text="Tiempo" Foreground="#64748b" FontSize="12"/><TextBlock Grid.Row="3" Grid.Column="1" Name="TxtBasePlaytime" Text="--" Foreground="White" HorizontalAlignment="Right" FontSize="12"/>
                                    </Grid>
                                </Border>

                                <!-- Información Detallada -->
                                <StackPanel Spacing="8" Margin="10,0">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Grid.Column="0" Text="INFORMACIÓN" Classes="Header" Foreground="#94a3b8" FontSize="11" FontWeight="Heavy"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Opacity="0.7">
                                            <Button Name="BtnWikiUrl" Background="Transparent" Padding="0" ToolTip.Tip="Visitar Wikipedia del juego" IsVisible="False">
                                                <TextBlock Text="🌐" FontSize="14" Foreground="#38bdf8"/>
                                            </Button>
                                            <Button Name="BtnVideoUrl" Background="Transparent" Padding="0" ToolTip.Tip="Ver video/tráiler" IsVisible="False">
                                                <TextBlock Text="▶" Foreground="#ef4444" FontSize="14"/>
                                            </Button>
                                            <Button Click="OnWikiSearchClick" Background="Transparent" Padding="0" ToolTip.Tip="Buscar en Wikipedia (Genérico)">
                                                <TextBlock Text="🔍" FontSize="14" Foreground="#94a3b8"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="{DynamicResource PanelBrush}" Padding="15" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                         <StackPanel Spacing="10">
                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoEsrb" Text="--" Foreground="White" DockPanel.Dock="Right" FontSize="12" FontWeight="Medium"/>
                                                 <TextBlock Text="Clasificación" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                             <Separator Background="#15ffffff"/>
                                             
                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoGenre" Text="--" Foreground="White" DockPanel.Dock="Right" FontSize="12" FontWeight="Medium"/>
                                                 <TextBlock Text="Género" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                             <Separator Background="#15ffffff"/>
                                             
                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoPlayMode" Text="--" Foreground="White" DockPanel.Dock="Right" FontSize="12" FontWeight="Medium"/>
                                                 <TextBlock Text="Modo de Juego" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                             <Separator Background="#15ffffff"/>

                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoProgress" Text="No Jugado" Foreground="#f59e0b" DockPanel.Dock="Right" FontSize="12" FontWeight="Medium"/>
                                                 <TextBlock Text="Progress" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                             <Separator Background="#15ffffff"/>

                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoRegion" Text="--" Foreground="White" DockPanel.Dock="Right" FontSize="12" FontWeight="Medium"/>
                                                 <TextBlock Text="Región" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                             <Separator Background="#15ffffff"/>

                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoStatus" Text="--" Foreground="White" DockPanel.Dock="Right" FontSize="12" FontWeight="Medium"/>
                                                 <TextBlock Text="Estado" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                             <Separator Background="#15ffffff"/>

                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoPortable" Text="No" Foreground="White" DockPanel.Dock="Right" FontSize="12" FontWeight="Medium"/>
                                                 <TextBlock Text="Portable" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                             <Separator Background="#15ffffff"/>

                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoFile" Text="--" Foreground="#38bdf8" DockPanel.Dock="Right" FontSize="11" TextWrapping="Wrap" MaxWidth="180"/>
                                                 <TextBlock Text="Archivo" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                             <Separator Background="#15ffffff"/>

                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoLastPlayed" Text="Nunca" Foreground="White" DockPanel.Dock="Right" FontSize="12"/>
                                                 <TextBlock Text="Última vez jugado" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                             <Separator Background="#15ffffff"/>

                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoReleaseDate" Text="--" Foreground="White" DockPanel.Dock="Right" FontSize="12" FontWeight="Medium"/>
                                                 <TextBlock Text="Fecha de Lanzamiento" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                             <Separator Background="#15ffffff"/>

                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoReleaseType" Text="--" Foreground="White" DockPanel.Dock="Right" FontSize="12" FontWeight="Medium"/>
                                                 <TextBlock Text="Tipo de Lanzamiento" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                             <Separator Background="#15ffffff"/>

                                             <DockPanel>
                                                 <TextBlock Name="TxtInfoMaxPlayers" Text="--" Foreground="White" DockPanel.Dock="Right" FontSize="12" FontWeight="Medium"/>
                                                 <TextBlock Text="Cantidad Máx. de Jugadores" Foreground="#64748b" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                             </DockPanel>
                                         </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Descripción -->
                                <StackPanel Spacing="8" Margin="10,0,10,0">
                                    <TextBlock Text="DESCRIPCIÓN" Classes="Header" Foreground="#94a3b8" FontSize="11" FontWeight="Heavy"/>
                                    <Border Background="{DynamicResource PanelBrush}" Padding="15" CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <TextBlock Name="TxtInfoDescription" Foreground="#cbd5e1" FontSize="13" TextWrapping="Wrap" Opacity="0.95" LineHeight="20"/>
                                    </Border>
                                </StackPanel>
                                           <!-- Playtime Commitment -->
                                <StackPanel Spacing="8" Margin="10,16,10,20" Name="PanelPlaytimeCommitment">
                                    <TextBlock Text="PLAYTIME COMMITMENT" Classes="Header" Foreground="#94a3b8" FontSize="11" FontWeight="Heavy"/>
                                    <Border Background="#28282C" Padding="15" CornerRadius="12">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnDefinitions="*, *">
                                                <!-- Beat the Game -->
                                                <Border Grid.Column="0" Background="#1e1e22" CornerRadius="8" Padding="10" Margin="0,0,5,0">
                                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                        <TextBlock Text="🏳" Foreground="White" FontSize="18" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Beat the Game" Foreground="#64748b" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        <TextBlock Name="TxtPlaytimeMain" Text="--" Foreground="White" FontSize="16" FontWeight="Heavy" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- Mastered -->
                                                <Border Grid.Column="1" Background="#1e1e22" CornerRadius="8" Padding="10" Margin="5,0,0,0">
                                                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                                                        <TextBlock Text="👑" Foreground="White" FontSize="18" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="Mastered" Foreground="#64748b" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        <TextBlock Name="TxtPlaytimeCompletionist" Text="--" Foreground="White" FontSize="16" FontWeight="Heavy" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <TextBlock Name="TxtPlaytimeProvider" Text="Provided by RetroAchievements" Foreground="#475569" FontSize="9" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Retro Achievements -->
                                <StackPanel Spacing="8" Margin="10,0,10,20" Name="PanelAchievementsSmall">
                                    <TextBlock Name="TxtAchievementsTitle" Text="RETRO ACHIEVEMENTS (SIN VINCULAR)" Classes="Header" Foreground="#94a3b8" FontSize="11" FontWeight="Heavy"/>
                                    <Border Background="#28282C" Padding="15" CornerRadius="12">
                                        <StackPanel Spacing="12">
                                            <ProgressBar Name="ProgAchievements" Value="0" Maximum="100" Height="4" Foreground="#00a2ff"/>
                                            <Grid ColumnDefinitions="*, Auto">
                                                <StackPanel Name="StackAchievementIcons" Orientation="Horizontal" Spacing="8"/>
                                                <Button Grid.Column="1" Name="BtnExpandAchievements" Content="Expandir" Padding="12,4" FontSize="10" Background="Transparent" BorderBrush="#475569" BorderThickness="1" CornerRadius="15"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    
                    <TabItem Header="Relacionados">
                        <ListBox Name="LstRelatedGames" Background="Transparent" BorderThickness="0" Margin="10">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="models:Game">
                                    <Border Background="{DynamicResource PanelBrush}" Margin="0,0,0,8" Padding="8" CornerRadius="8">
                                        <Grid ColumnDefinitions="Auto, *">
                                            <Image Grid.Column="0" Source="{Binding Cover, Converter={StaticResource ByteToBitmap}}" Width="45" Height="65" Stretch="UniformToFill" Margin="0,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="13"/><TextBlock Text="{Binding Genre}" Foreground="#64748b" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </Panel>
    </ScrollViewer>
</UserControl>
